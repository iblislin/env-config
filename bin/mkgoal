#!/usr/bin/env bash
# Turn a rough intent into a validated /goal condition.
#
# All judgment lives in the writing-goal-conditions skill. This wrapper only
# moves bytes: read the intent, invoke claude, split the reply at the sentinel,
# map STATUS= onto an exit code. Keep it that way — a criterion that leaks in
# here becomes a second place to maintain the template.
#
# ⚠️ Cross-repo dependency: that skill lives in a SEPARATE PRIVATE repository
# (iblislin/claude-config, cloned to ~/.claude), because it carries internal
# operational detail. Cloning this public repo alone gives you a mkgoal with no
# skill to invoke — it will run and produce nothing usable.
set -uo pipefail

PROG="$(basename "$0")"
CLAUDE="${MKGOAL_CLAUDE:-claude}"
SENTINEL='---MKGOAL-VERDICT---'
# The harness refuses a /goal submission outright past this many characters,
# measured on the condition text after the `/goal ` prefix (trailing newline
# not counted) -- measured 2026-09-11, a 4556-character draft was rejected
# with "Goal condition is limited to 4000 characters (got 4556)". The 3800
# drafting target that absorbs a later hand-edit lives in the
# writing-goal-conditions skill as drafting judgment; this is the mechanical
# check on what actually got produced.
CHAR_CAP=4000
# Drafting model/effort are overridable so they can be benchmarked without
# editing this file. The judges are NOT affected -- the skill pins them to haiku
# through the Agent tool, deliberately, so the dry run matches the live evaluator.
MODEL="${MKGOAL_MODEL:-opus}"
EFFORT="${MKGOAL_EFFORT:-low}"

usage() {
    cat <<EOF
Usage: $PROG [rough intent...]
       $PROG < file

Reads a rough intent (argv, else stdin) and prints a validated /goal condition
on stdout. The verdict and the judge's reasoning go to stderr.

Runs in the current directory so the repo's CLAUDE.md and skills load — draft
quality depends on them.

  echo "take IOT-441 as far as an open MR with green CI" | $PROG

Exit: 0  both dry-run samples judged correctly
      1  still failing after 3 rewrites (stdout still carries the last draft),
         or a malformed reply
      2  empty input
      3  condition exceeds the $CHAR_CAP-character submit cap (stdout still
         carries the draft, for hand-trimming)
EOF
}

if [ $# -gt 0 ]; then
    case "$1" in -h|--help) usage; exit 0 ;; esac
    intent="$*"
else
    intent="$(cat)"
fi

if [ -z "${intent//[[:space:]]/}" ]; then
    usage >&2
    exit 2
fi

# `< /dev/null` is load-bearing: our own stdin is already consumed by the read
# above, and claude waits 3s for stdin before warning about it on stderr.
# Without this, every invocation pays that delay and leaks a warning into the
# verdict block.
# Drafting: opus for the repo knowledge, but --effort low because this is
# template-following rather than deep reasoning, and the session default here is
# xhigh (which made the first runs take minutes). The judge is NOT affected --
# the skill pins it to haiku via the Agent tool's model parameter, verified to
# actually take effect, and deliberately leaves the judge's effort unset so it
# stays close to what the live /goal evaluator does.
reply="$("$CLAUDE" -p --model "$MODEL" --effort "$EFFORT" --no-session-persistence "$(printf '%s\n\n%s' \
    'Use the writing-goal-conditions skill to turn the intent below into a validated /goal condition. Follow that skill'"'"'s output shape exactly: the /goal condition first, then the sentinel line, then the verdict block. No preamble.' \
    "$intent")" < /dev/null)" || {
    printf '%s: claude invocation failed\n' "$PROG" >&2
    exit 1
}

# A reply with no sentinel is malformed. Surface it whole on stderr rather than
# piping something unexpected into the user's buffer.
if ! printf '%s\n' "$reply" | grep -qF -- "$SENTINEL"; then
    printf '%s: reply had no %s sentinel:\n%s\n' "$PROG" "$SENTINEL" "$reply" >&2
    exit 1
fi

# Extract from the first `/goal ` line rather than from the top of the reply, so
# a conversational preamble is dropped instead of landing in the user's buffer.
# Arguing with the model about preambles is fragile: invoking the skill as
# `/writing-goal-conditions <intent>` loses this wrapper's own "No preamble"
# reinforcement and did emit one (2026-08-10), while the prose form did not.
# Being resilient here makes the invocation style a free choice.
if ! printf '%s\n' "$reply" | grep -q '^/goal '; then
    printf '%s: reply contained no /goal line:\n%s\n' "$PROG" "$reply" >&2
    exit 1
fi
condition="$(printf '%s\n' "$reply" | sed -n "/^\/goal /,\$p" | sed "/^${SENTINEL}\$/,\$d")"
printf '%s\n' "$condition"
printf '%s\n' "$reply" | sed -n "/^${SENTINEL}\$/,\$p" >&2

# Measure on the same basis the harness enforces: after the `/goal ` prefix,
# trailing newline not counted (command substitution above already stripped
# it). python3, not `wc -c`/`wc -m`, because this must count characters
# regardless of locale, and the condition can carry multi-byte text.
body_chars="$(printf '%s' "$condition" | python3 -c 'import sys; print(len(sys.stdin.read()[6:]))' 2>/dev/null)"
over_cap=0
case "$body_chars" in
    # A measurement that did not happen must not read as "not over cap". This
    # script is `set -uo pipefail` without `-e`, so an absent or broken python3
    # leaves body_chars empty, `[ "" -gt N ]` fails with "integer expected",
    # and execution simply carries on with over_cap=0 -- a silent pass that
    # looks exactly like a condition within budget.
    ''|*[!0-9]*)
        printf '%s: could not measure the condition length (python3 gave %s), so the %d-character cap was NOT checked -- treat this draft as unverified, not as within budget.\n' \
            "$PROG" "${body_chars:-no output}" "$CHAR_CAP" >&2
        ;;
    *)
        if [ "$body_chars" -gt "$CHAR_CAP" ]; then
            over_cap=1
            printf '%s: condition is %d characters after the /goal prefix, over the %d-character submit cap -- the harness will refuse this outright. Trim it by hand; the draft above is still what was produced.\n' \
                "$PROG" "$body_chars" "$CHAR_CAP" >&2
        fi
        ;;
esac

# The skill pins the judges to haiku via the Agent tool and reports what they
# said they were. Verify it rather than trusting it: a run judged by opus is
# stricter than the live evaluator, so it would pass conditions that then stall
# a real goal -- the exact failure the dry run exists to prevent.
if ! printf '%s\n' "$reply" | grep -qi '^judge_model=.*haiku'; then
    jm="$(printf '%s\n' "$reply" | grep -i '^judge_model=' || true)"
    printf '%s: WARNING: judges were not confirmed to be haiku (%s).\n' \
        "$PROG" "${jm:-no judge_model line at all}" >&2
    printf '%s:          a stricter judge than the live evaluator can pass a\n' "$PROG" >&2
    printf '%s:          condition that then stalls. Treat this draft as unproven.\n' "$PROG" >&2
fi

if [ "$over_cap" -eq 1 ]; then
    exit 3
fi
printf '%s\n' "$reply" | grep -q '^STATUS=pass$' && exit 0
exit 1
