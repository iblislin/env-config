#!/usr/bin/env bash
# claude-attn-hook <status>
#
# Claude Code Stop / Notification hook.
# Records which tmux window a Claude session is in, its current
# attention status, and a human-readable session label, so
# `claude-attn-board` can surface it across all tmux sockets/servers.
#
#   UserPromptSubmit hook -> status "running" (Claude started working)
#   Stop             hook -> status "done"    (response finished)
#   Notification     hook -> status "waiting" (needs input / permission)
#
# Session label preference: /rename custom title -> Claude ai-title ->
# (blank). Read from the transcript whose path Claude passes on stdin.
#
# State is written per-window under ~/.claude/tmux-status/ and is
# auto-cleared by the board once you actually visit that window.
set -u

status="${1:-done}"
STATE_DIR="$HOME/.claude/tmux-status"
mkdir -p "$STATE_DIR"

# Capture Claude's stdin JSON payload and resolve the session title via
# the cursor-cached resolver (custom-title -> ai-title -> blank).
payload="$(cat 2>/dev/null || true)"
label="$(printf '%s' "$payload" | "$(dirname "$0")/claude-attn-title" 2>/dev/null | head -c 200)"

# We can only locate the window when running inside tmux.
pane="${TMUX_PANE:-}"
[ -n "$pane" ] || exit 0

# $TMUX = "<socket_path>,<server_pid>,<session_id>"
socket="${TMUX%%,*}"
[ -n "$socket" ] || exit 0

info="$(tmux -S "$socket" display-message -p -t "$pane" \
  -F '#{session_name}	#{window_index}	#{window_name}	#{pane_current_path}	#{pane_tty}' 2>/dev/null)"
[ -n "$info" ] || exit 0

IFS=$'\t' read -r sess win wname cpath ptty <<<"$info"

# Ring this window's bell so tmux sets window_bell_flag -> the board's
# "unread" signal, cleared only when you select the window. RUNNING does
# NOT need your attention, so it never rings the bell.
if [ "$status" != "running" ] && [ "$status" != "end" ]; then
  [ -n "$ptty" ] && [ -w "$ptty" ] && printf '\a' >"$ptty" 2>/dev/null || true
fi
sockname="$(basename "$socket")"
# Sanitize key components (paths/names may contain slashes/spaces).
safe() { printf '%s' "$1" | tr '/ \t' '___'; }
key="$(safe "$sockname")__$(safe "$sess")__$(safe "$win")"

# SessionEnd hook -> status "end": the Claude session in this window has closed
# for good, so drop the window's inbox entry (and its viewed stamp) instead of
# leaving it as a stale "done"/"waiting" that cleanup_stale keeps while the tmux
# window itself still exists. Skip the in-place resets: on /clear and /resume
# the window keeps a live Claude that re-registers on its next prompt.
if [ "$status" = "end" ]; then
  reason="$(printf '%s' "$payload" | sed -n 's/.*"reason"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  case "$reason" in clear|resume) exit 0 ;; esac
  rm -f "$STATE_DIR/$key" "$STATE_DIR/.viewed/$key" 2>/dev/null || true
  printf '%s\t%-7s\t%s:%s\t[%s]\treason=%s\n' \
    "$(date '+%F %T')" "end" "$sess" "$win" "$sockname" "${reason:-?}" \
    >>"$STATE_DIR/.attn.log" 2>/dev/null || true
  exit 0
fi

# Fields: ts  status  sess:win  wname  sockname  cpath  label
printf '%s\t%s\t%s:%s\t%s\t%s\t%s\t%s\n' \
  "$(date +%s)" "$status" "$sess" "$win" "$wname" "$sockname" "$cpath" "$label" \
  >"$STATE_DIR/$key"

# --- bounded event log (history / debugging) ------------------------
# Append one human-readable line per event. Self-rotates so it can never
# grow without bound: once over ~256 KiB, trim to the last 2000 lines.
log="$STATE_DIR/.attn.log"
printf '%s\t%-7s\t%s:%s\t[%s]\t%s\n' \
  "$(date '+%F %T')" "$status" "$sess" "$win" "$sockname" "$label" >>"$log" 2>/dev/null
sz="$(stat -c%s "$log" 2>/dev/null || echo 0)"
if [ "$sz" -gt 262144 ]; then
  tail -n 2000 "$log" >"$log.tmp" 2>/dev/null && mv -f "$log.tmp" "$log" 2>/dev/null
fi

# --- desktop notification (cross-virtual-desktop) -------------------
# The tmux bell only sticks on NON-active windows, and tmux is blind to
# virtual-desktop switches, so the board/bell can silently miss a window
# you left "active" on another desktop. A libnotify popup reaches you on
# whatever desktop you are on. Only for WAITING (Claude needs you).
if [ "$status" = "waiting" ] && command -v notify-send >/dev/null 2>&1; then
  : "${DISPLAY:=:0}"; export DISPLAY
  [ -z "${XDG_RUNTIME_DIR:-}" ] && export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && \
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
  timeout 3 notify-send -u critical -a claude-attn \
    "🔔 Claude needs you — ${sess}:${win}" "${label:-$wname}" >/dev/null 2>&1 || true
fi

exit 0
