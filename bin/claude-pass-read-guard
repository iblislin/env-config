#!/usr/bin/env bash
# PreToolUse(Bash) guard that pre-approves the two `pass` reads which expose
# nothing: listing and finding entry NAMES. Everything else about `pass` is left
# alone, so the `Bash(pass *)` ask rule still catches it.
#
# Reads the hook payload on stdin, emits a PreToolUse decision on stdout.
# Silence (exit 0, no output) means "no opinion" — the call falls through to the
# normal permission flow, which is the ask prompt.
#
# WHY THIS EXISTS: `permissions.allow` cannot do this job. Rules are evaluated
# deny -> ask -> allow, first match wins, and *rule specificity does not change
# that order* — so `Bash(pass ls)` in allow loses to `Bash(pass *)` in ask.
# Verified 2026-08-21 in one fresh `claude -p` process: a control allow rule
# (`Bash(true)`) RAN while `Bash(pass ls)` was DENIED, proving the rules were
# loaded and the ask rule is what won.
#
# WHY NARROWING THE ask RULE WAS REJECTED INSTEAD: `show` is pass's DEFAULT
# subcommand, so a bare `pass <entry-path>` prints that credential with no
# subcommand keyword at all. The dangerous shape is `pass <any entry path>` — an
# open set — while the safe shape is a tiny closed set. No prefix glob separates
# them. Enumerating entry folders instead (`Bash(pass gitlab*)` …) would fail
# silently the day a new credential category is added, which is the exact mistake
# CLAUDE.md records having made twice with a hard-coded entry inventory.
#
# ⚠️ AN ALLOW GUARD IS NOT A DENY GUARD. A restrictive hook that is too loose
# merely annoys; a permissive one that is too loose prints a secret. So this is a
# strict allowlist with two independent gates, and anything unrecognised falls
# through to the prompt rather than being approved:
#
#   Gate 1 — character set. The whole command may contain only [A-Za-z0-9 _./@:-].
#            That removes every shell metacharacter, so `pass ls; pass show x`
#            cannot ride in on a matched prefix. This is what makes the shape
#            check below safe to reason about at all.
#   Gate 2 — shape. The ENTIRE command, anchored, must be `pass` alone or
#            `pass <ls|find|help|version>` plus arguments that cannot start with
#            a dash (no flags).
#
# `ls` and `find` list names only; CLAUDE.md states entry names are not secret.
# `grep` is deliberately NOT here and must never be added: it decrypts every
# entry to search contents, and it is one character away from `find`.

# TESTING WITHOUT TOUCHING REAL CREDENTIALS: `pass ls` and `pass find` walk the
# directory tree and never decrypt, so a throwaway store needs no GPG key at all
# — a directory, a `.gpg-id` holding any string, and empty `*.gpg` files:
#
#   D=$(mktemp -d); mkdir -p "$D/svc"; echo 0 > "$D/.gpg-id"; : > "$D/svc/token.gpg"
#   PASSWORD_STORE_DIR="$D" pass ls          # lists svc/token
#   PASSWORD_STORE_DIR="$D" pass show svc/token   # fails in gpg, leaks nothing
#
# ⚠️ That fixture cannot exercise the ALLOW path of this hook, and deliberately so:
# an env-var prefix is not the bare form, so `PASSWORD_STORE_DIR=… pass ls` falls
# through to the prompt (verified 2026-08-21). Allowing it would mean approving a
# store path chosen at call time. The allow path is only reachable by a bare
# `pass ls` against the configured store — which is the safe, name-only read this
# hook exists to wave through. Prefer the JSON pipe-test for the decision logic:
# feed {"tool_input":{"command":"…"}} on stdin and assert allow vs silence, and
# treat EMPTY OUTPUT as silence — a jq filter over no input prints nothing, which
# is how a harness quietly reports every deferral as a failure.

set -uo pipefail

payload="$(cat)"
cmd="$(printf '%s' "$payload" | jq -r '.tool_input.command // empty' 2>/dev/null)"
[ -n "$cmd" ] || exit 0

# Cheap bail-out so this costs nothing on the vast majority of Bash calls.
case "$cmd" in
    pass|pass\ *) ;;
    *) exit 0 ;;
esac

# Gate 1 — character set. Anything outside it means no opinion.
printf '%s' "$cmd" | grep -qE '^[A-Za-z0-9 _./@:-]+$' || exit 0

# Gate 2 — shape, anchored over the whole command. An argument must begin with
# an alphanumeric, `_`, `.` or `/`, which is what keeps `-` flags out.
safe_arg='[A-Za-z0-9_./][A-Za-z0-9_./@:-]*'
if printf '%s' "$cmd" \
    | grep -qE "^pass([[:space:]]+(ls|find|help|version)([[:space:]]+${safe_arg})*)?[[:space:]]*$"; then
    jq -n '{
      hookSpecificOutput: {
        hookEventName: "PreToolUse",
        permissionDecision: "allow",
        permissionDecisionReason: "Listing or finding pass entry NAMES exposes no secret — CLAUDE.md states entry names are not secret, and says to read the live list rather than trust a written-down inventory. Pre-approved by claude-pass-read-guard, which allows only `pass`, `pass ls`, `pass find`, `pass help` and `pass version` with flag-free arguments and no shell metacharacters. Every other pass invocation, including a bare `pass <entry>` (show is the default subcommand), still goes through the ask prompt."
      }
    }'
    exit 0
fi

exit 0
