#!/usr/bin/env python3
"""PreToolUse deny: keep the WARNING SIGN (U+26A0) out of newly written prose.

The standard (internal-group/claude-plugins !12, note_30790, the user's own words): the
symbol "buys nothing, well, the attention still could decay if the context is
long", and newly written or rewritten docs drop it. note_30793 settled it as
"none at all" rather than "do not overuse". Legacy occurrences are NOT swept.

Replacement: drop the symbol and let an opening bold clause carry the emphasis.

Scope, widened 2026-09-04 on the user's instruction ("all code comment, all
doc"), after a real miss: a long block comment in a `.ts` file read exactly like
a markdown paragraph and passed, because the first version only matched docs.

Why a deny and not a PostToolUse strip
--------------------------------------
Deleting a character looks mechanical, which is when CLAUDE.md says to make the
repair a side effect instead of a message. It is not mechanical here: whether an
occurrence is emphasis or subject matter is a judgement, and a silent strip would
corrupt prose that quotes the symbol.

The two discriminators
----------------------
1. **Only what this edit INTRODUCES.** Legacy is not being swept, so an Edit that
   carries an existing occurrence through unchanged passes; only a net increase is
   refused. Without this the hook enforces a stricter standard than was agreed.
2. **Subject matter stays writable.** In markdown: a backtick span, a fenced
   block, or a blockquote line. In source: only *comment* text is inspected at
   all, and a backtick span inside the comment is the same escape. Code, string
   literals and regexes are never inspected — which is also why this file may
   discuss the symbol freely: it writes it as an escape, never as the glyph.

Known limits, stated rather than discovered later
-------------------------------------------------
* Fence and comment detection run over the ADDED text only, so an Edit landing
  inside a block that opened earlier in the file reads as ordinary prose. That
  direction over-refuses rather than under-refuses, and the message says how to
  proceed. A peer hit exactly this while testing the guard: a JSON payload on the
  same line as a `.md` redirect was refused.
* Bash is matched only for a heredoc or redirect landing in a text file. An
  arbitrary command carrying the character — `glab api` posting a comment that
  discusses it — is deliberately untouched; blocking that was the failure to
  avoid.

Exit 0 with no output = no opinion. Never blocks on its own error.
"""
import json
import os
import re
import sys

SIGN = "⚠"
VS16 = "️"
WARN = re.compile(SIGN + VS16 + "?")

# Markdown-ish: the whole file is prose.
PROSE_EXT = re.compile(r"\.(md|markdown|mdx|rst|txt|adoc)$", re.I)
PROSE_NAME = re.compile(r"(^|/)(AGENTS|CLAUDE|README|SKILL|CHANGELOG)\.md$", re.I)
# Source: only comment text is inspected.
CODE_EXT = re.compile(
    r"\.(ts|tsx|js|jsx|mjs|cjs|py|pyi|go|rs|java|kt|scala|sh|bash|zsh|rb|c|h|"
    r"cc|cpp|hpp|sql|yml|yaml|toml|tf|vue|css|scss|html)$", re.I)
# One-line and block comment openers, enough for the languages above.
COMMENT = re.compile(r"(//|#|/\*|\*|--|<!--|;)\s*(?P<text>.*)$")

BASH_TEXT_WRITE = re.compile(
    r"(>>?|\btee\b)\s*[\"']?([^\s\"'|;&]+\.(?:md|markdown|mdx|rst|txt|adoc|ts|tsx|"
    r"js|py|go|rs|java|sh|yml|yaml|toml|sql|css|scss|html))", re.I)

MESSAGE = (
    "Drop the warning sign and move the emphasis into an opening bold clause:\n"
    "      **A guard may be doing a second job nobody wrote down, and this is "
    "the trap in the rule.**\n"
    "It buys nothing, and attention decays anyway once the context is long "
    "(internal-group/claude-plugins !12, note_30790). Legacy occurrences are NOT being "
    "swept — only newly written prose, which is why this refuses a net increase "
    "and not its mere presence. To write ABOUT the symbol, put it in a backtick "
    "span, a fenced block, or a blockquote line; in source, only comment text is "
    "inspected at all.\n%s")


def strip_escapes(line):
    """Remove backtick spans — the documented way to write about the symbol."""
    return re.sub(r"`[^`]*`", "", line)


def prose_hits(text, code_only):
    """Occurrences in TEXT that are emphasis rather than subject matter."""
    hits, in_fence = [], False
    for raw in text.split("\n"):
        line = raw.strip()
        if not code_only:
            if line.startswith("```") or line.startswith("~~~"):
                in_fence = not in_fence
                continue
            if in_fence or line.startswith(">"):
                continue
            candidate = raw
        else:
            m = COMMENT.search(raw)
            if not m:
                continue          # not a comment: code, literals, regexes
            candidate = m.group("text")
        if WARN.search(strip_escapes(candidate)):
            hits.append(line[:90])
    return hits


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason}}))
    sys.exit(0)


def classify(path):
    if PROSE_EXT.search(path) or PROSE_NAME.search(path):
        return False          # whole file is prose
    if CODE_EXT.search(path):
        return True           # comments only
    return None               # out of scope


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    tool = payload.get("tool_name") or ""
    inp = payload.get("tool_input") or {}

    if tool in ("Edit", "Write"):
        code_only = classify(inp.get("file_path") or "")
        if code_only is None:
            return
        if tool == "Edit":
            before = len(WARN.findall(inp.get("old_string") or ""))
            after = prose_hits(inp.get("new_string") or "", code_only)
        else:
            after = prose_hits(inp.get("content") or "", code_only)
            before = 0
            try:
                with open(os.path.expanduser(inp["file_path"]), encoding="utf-8") as fh:
                    before = len(WARN.findall(fh.read()))
            except (OSError, KeyError):
                before = 0
        if len(after) > before:
            deny(MESSAGE % ("Introduced on: " + after[0]))

    elif tool == "Bash":
        cmd = inp.get("command") or ""
        if WARN.search(cmd) and BASH_TEXT_WRITE.search(cmd):
            deny(MESSAGE % (
                "Also: this writes a file through the shell, where a Write/Edit "
                "matcher cannot see it. Use the Write or Edit tool instead — see "
                "CLAUDE.md § Write files with Write / Edit, not through Bash."))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
