#!/usr/bin/env python3
"""Issue and inspect approve tickets ("AMToken") for the CURRENT Claude session.

WHY THIS EXISTS
---------------
A `permissions.ask` rule cannot be pre-satisfied. Measured, and documented by
Anthropic in all four directions: an `allow` rule loses to `ask`, a PreToolUse
hook returning "allow" loses to `ask`, a skill's `allowed-tools` loses to `ask`,
and the `ask` dialog itself offers only Yes/No with no session-scoped option.
So an unattended run that reaches `glab mr approve` stops dead until a human
answers -- which in practice has been 5 hours, and once a whole week.

The only direction left is to invert the mechanism: deny the raw command, and
authorise a surrogate with a ticket issued while the human is present. This
tool issues that ticket. `glab-mr-approve` consumes it.

Full motivation, the research, and the rejected alternatives:
~/doc/2026-09-10-unattended-approval-starvation.md

THERE IS NO WAY FOR THIS TOOL TO TELL THE HUMAN FROM THE AGENT
--------------------------------------------------------------
The first version refused unless it could open /dev/tty, on the theory that the
`!` prefix runs in the session's own shell and therefore has a controlling
terminal while a tool-run shell does not. **Measured on both sides, and the
theory is wrong**: `/dev/tty` is "no such device or address" in *both*, and
`tty` reports "not a tty" in both. That check refused the legitimate user and
stopped nobody, so it is gone.

Nothing replaced it, deliberately, because nothing available would work:

* **The environment is shared.** `CLAUDE_CODE_SESSION_ID` and `TMUX_PANE` are
  byte-identical across the `!` shell, the Bash tool, and subagents -- which is
  the property this design *relies* on for keying, and the same property that
  makes env useless as a discriminator.
* **An interactive confirmation is impossible in either context.** Neither has a
  terminal to read from, so a y/N prompt fails closed for the human too.
* **A secret typed on the command line is not secret.** A `!` command line
  arrives in the agent's context verbatim, as `<bash-input>`.
* **A pty is cheap to fake anyway.** `script -q -c '...' /dev/null` allocates
  one, as does `python3 -c 'import pty; pty.spawn(...)'` or a container with
  `-t` -- the user's own observation, and it defeats any tty-shaped test.

**So the gate is the `permissions.deny` rule on this command, and nothing else.**
That rule is a pattern match over the command string, not a sandbox (Anthropic's
words: it "isn't a security boundary around the program"), and it is measured to
fire: a tool-run command containing `am-token grant` was refused by the harness
on the first attempt. It stops the cooperative and the accidental path, which is
the one that actually happens.

Nor is the ticket the weakest link. `~/.config/glab-cli/config.yml` holds a live
token, so anything that can read a file can approve an MR over the REST API
without this tool at all. Hardening the ticket further would be locking a window
while that door stands open.

**The real controls are therefore not mechanisms:**

1. **Do not create the motive.** Never write a /goal condition ending at "MR
   approved" -- a run under that pressure has every reason to route around the
   gate rather than report BLOCKED.
2. **Make every spend visible.** The audit log and the `blocked/` records exist
   so that an approval nobody authorised is *detectable*, since it cannot be
   *prevented*.

WHY THE TICKET IS KEYED BY SESSION ID
-------------------------------------
`CLAUDE_CODE_SESSION_ID` is byte-identical in the parent, in its subagents, and
in the `!` shell -- all three measured on this machine. So the issuer and the
consumer derive the same key with neither being told it, and a ticket covers
exactly the one session tree that was authorised. Peer sessions have their own.

USES, NOT TIME, IS THE PRIMARY BOUND
------------------------------------
`--uses` bounds the blast radius: how many MRs may be approved. `--ttl` bounds
only the freshness of consent and defaults to *none*, deliberately. A ticket
that expires while nobody is watching re-creates the starvation it exists to
prevent -- that is trading the failure the user hates for a risk they do not
have. Keep `--uses` small; leave time alone.
"""
import argparse
import fcntl
import json
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
DIR = os.path.join(HOME, ".claude", "am-tokens")
AUDIT = os.path.join(DIR, "audit.log")
SESSION = (os.environ.get("CLAUDE_CODE_SESSION_ID") or "").strip()


def die(msg, code=1):
    sys.stderr.write("am-token: %s\n" % msg)
    sys.exit(code)


def ticket_path(session=None):
    return os.path.join(DIR, "%s.json" % (session or SESSION))


def ensure_dir():
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    os.chmod(DIR, 0o700)


def audit(event, **fields):
    """Append-only record. The point of a ticket is that approvals now happen
    while nobody is watching, so without this there is no answer to "did I
    authorise that merge?" -- and in this fleet approve IS merge."""
    ensure_dir()
    row = dict(ts=int(time.time()), iso=time.strftime("%F %T"), event=event,
               session=SESSION, **fields)
    with open(AUDIT, "a", encoding="utf-8") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        fh.write(json.dumps(row, sort_keys=True) + "\n")


def parse_ttl(s):
    """'5h' / '30m' / '3d' / '0' -> seconds. 0 means never expires."""
    if not s or s == "0":
        return 0
    unit, mult = s[-1], {"s": 1, "m": 60, "h": 3600, "d": 86400}
    if unit not in mult:
        die("bad --ttl %r: use 30m, 5h, 3d, or 0 for no expiry" % s, 64)
    try:
        return int(s[:-1]) * mult[unit]
    except ValueError:
        die("bad --ttl %r" % s, 64)


def origin_project(cwd=None):
    """`internal-group/latex-common` from this directory's origin remote, or None.

    The default scope, because `! am-token grant` is typed from inside the repo
    being worked on. Works in a worktree, which is where an L3 run lives.

    Returns None rather than falling back to `*`: a failure to identify the repo
    must not silently WIDEN a ticket the user asked to narrow. cmd_grant turns
    None into a refusal that names `--scope`.
    """
    try:
        r = subprocess.run(["git", "remote", "get-url", "origin"],
                           capture_output=True, text=True, timeout=10,
                           cwd=cwd or os.getcwd())
    except Exception:
        return None
    if r.returncode != 0:
        return None
    url = r.stdout.strip()
    if not url:
        return None
    if url.endswith(".git"):
        url = url[:-4]
    # scp-like (git@host:group/project) has no scheme; a URL does.
    if "://" in url:
        path = url.split("://", 1)[1].split("/", 1)
        path = path[1] if len(path) > 1 else ""
    elif ":" in url:
        path = url.split(":", 1)[1]
    else:
        path = url
    path = path.strip("/")
    return path or None


def load(session=None):
    try:
        with open(ticket_path(session), encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def state_of(t, now=None):
    """One of: none / expired / exhausted / valid."""
    now = now or int(time.time())
    if not t:
        return "none"
    if t.get("expires_at") and now >= t["expires_at"]:
        return "expired"
    if t.get("uses_remaining", 0) <= 0:
        return "exhausted"
    return "valid"


def fmt(t):
    if not t:
        return "(none)"
    exp = t.get("expires_at")
    when = time.strftime("%F %T", time.localtime(exp)) if exp else "never"
    return ("%s · %d/%d uses left · expires %s · scope %s · granted %s"
            % (state_of(t), t.get("uses_remaining", 0), t.get("uses_granted", 0),
               when, t.get("scope", "*"),
               time.strftime("%F %T", time.localtime(t.get("granted_at", 0)))))


def cmd_grant(args):
    if not SESSION:
        die("CLAUDE_CODE_SESSION_ID is unset -- run this inside a Claude "
            "session with the `!` prefix, not from a bare shell.", 64)

    # No tty check and no confirmation prompt: see the module docstring. Both
    # were tried, both fail closed for the HUMAN as well, and neither would
    # stop an agent. The gate is the permissions.deny rule on this command.
    scope = args.scope
    if scope is None:
        scope = origin_project()
        if not scope:
            die("cannot tell which project to scope this to: no `origin` remote "
                "in %s.\n  Run it from inside the repo, or pass --scope "
                "'<group>/<project>' (or --scope '*' to allow any, which is "
                "wider than you probably want)." % os.getcwd(), 64)

    ttl = parse_ttl(args.ttl)
    now = int(time.time())
    ensure_dir()
    t = dict(session=SESSION, uses_granted=args.uses, uses_remaining=args.uses,
             granted_at=now, expires_at=(now + ttl) if ttl else 0,
             scope=scope, granted_from_pane=os.environ.get("TMUX_PANE", ""),
             granted_from_cwd=os.getcwd())
    path = ticket_path()
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(t, fh, indent=2, sort_keys=True)
    os.chmod(path, 0o600)
    audit("grant", uses=args.uses, scope=scope, expires_at=t["expires_at"])

    # This line lands in the agent's context, because `!` output does (observed).
    # STATE ONLY, never an instruction: an imperative here would send a helpful
    # agent looking for an MR to approve, and at grant time there usually is
    # none. The policy -- use the surrogate, never the raw command, report
    # BLOCKED without a ticket -- lives in CLAUDE.md, which is always loaded.
    # Repeating it here would be the same rule in two homes, and this is the
    # copy that gets reprinted daily.
    print("AMToken issued for this session: %d use(s), %s, scope %s."
          % (args.uses, "no expiry" if not ttl else "expires in " + args.ttl,
             scope))
    print("(state only -- use it when you reach the approve step)")


def cmd_status(args):
    t = load()
    print("session %s: %s" % (SESSION[:8] or "(unset)", fmt(t)))
    blocked = os.path.join(DIR, "blocked", "%s.json" % SESSION)
    if os.path.exists(blocked):
        b = json.load(open(blocked, encoding="utf-8"))
        print("  BLOCKED %s ago: %s" % (
            fmt_age(int(time.time()) - b["ts"]), b.get("target", "?")))
    return 0 if state_of(t) == "valid" else 1


def fmt_age(a):
    for lim, unit, div in ((60, "s", 1), (3600, "m", 60),
                           (86400, "h", 3600), (10 ** 9, "d", 86400)):
        if a < lim:
            return "%d%s" % (a // div, unit)


def cmd_list(args):
    ensure_dir()
    rows = []
    for name in sorted(os.listdir(DIR)):
        if not name.endswith(".json"):
            continue
        rows.append((name[:-5], load(name[:-5])))
    if not rows:
        print("no tickets")
    for sid, t in rows:
        mark = "*" if sid == SESSION else " "
        print("%s %s  %s" % (mark, sid[:8], fmt(t)))
    bdir = os.path.join(DIR, "blocked")
    if os.path.isdir(bdir):
        stale = sorted(os.listdir(bdir))
        if stale:
            print("\nruns that asked for a ticket and had none:")
            for name in stale:
                b = json.load(open(os.path.join(bdir, name), encoding="utf-8"))
                print("  %s  %s ago  %s" % (name[:8].rstrip(".json"),
                                            fmt_age(int(time.time()) - b["ts"]),
                                            b.get("target", "?")))


def cmd_scope(args):
    """Print what `grant` would default --scope to, here. Read-only.

    Exists so the zsh completion and a human sanity-check can both ask THIS
    tool rather than re-implementing the origin-URL parsing in shell -- one
    home for that rule. Not gated: it grants nothing.
    """
    p = origin_project()
    if not p:
        sys.stderr.write("am-token: no origin remote in %s\n" % os.getcwd())
        return 1
    print(p)
    return 0


def cmd_revoke(args):
    path = ticket_path()
    if os.path.exists(path):
        os.unlink(path)
        audit("revoke")
        print("revoked")
    else:
        print("nothing to revoke")


def main():
    p = argparse.ArgumentParser(prog="am-token", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    g = sub.add_parser("grant", help="issue a ticket for THIS session "
                                     "(run it as `! am-token grant ...`)")
    g.add_argument("--uses", type=int, default=1,
                   help="approvals allowed; this is the bound that matters (default 1)")
    g.add_argument("--ttl", default="0",
                   help="30m/5h/3d, or 0 for no expiry (default 0 -- see the docstring)")
    g.add_argument("--scope", default=None,
                   help="project the ticket may be spent on, as a glob. Default: "
                        "this directory's `git remote get-url origin` project, "
                        "since this is typed from inside the repo being worked "
                        "on. Refuses rather than widening to '*' if that cannot "
                        "be determined.")
    g.set_defaults(fn=cmd_grant)

    for name, fn, helptext in (("status", cmd_status, "this session's ticket"),
                               ("list", cmd_list, "every ticket, plus blocked runs"),
                               ("scope", cmd_scope, "what --scope would default to here"),
                               ("revoke", cmd_revoke, "drop this session's ticket")):
        s = sub.add_parser(name, help=helptext)
        s.set_defaults(fn=fn)

    args = p.parse_args()
    sys.exit(args.fn(args) or 0)


if __name__ == "__main__":
    main()
