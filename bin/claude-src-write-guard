#!/usr/bin/env python3
"""PreToolUse/Bash guard: steer source-file writes to the Read+Edit path.

WHY
---
Path-scoped rules under `.claude/rules/` load when a matching file is READ.
Measured 2026-08-26, three controlled `claude --model haiku` runs, verdict
taken from the transcripts rather than the agents' self-reports:

  bash heredoc creating a .py -> 0 rule injections
  Write creating a .py        -> 0 rule injections
  Read of that .py            -> 1 injection (.claude/rules/python-style.md)
  Read of a non-matching .rst -> 0 injections   (negative control)

So a file edited through Bash never loads its own conventions. `Edit` is
immune by construction -- it hard-fails with "File has not been read yet"
(measured, same day), which forces the Read that triggers the injection.

DESIGN: RESOLVE THE CONTEXT, THEN LOOK FOR WRITES
-------------------------------------------------
The first version pattern-matched the whole command string and scored a 39%
false-positive rate over 56,513 real commands. Three of its worst families had
one root cause: a write pattern was matched against text that was never going
to execute -- a document sitting in a heredoc, an example inside a quoted
string, a read-only `open()` in the same script as the real write.

So this version separates the command into what the shell runs and what an
interpreter runs, matches shell patterns only against the former and python
patterns only against the latter, and binds each match to the path in that
same call. Then the target is resolved (variables expanded, `~` expanded, made
absolute) before any exemption is consulted.

TWO WAYS A TARGET COUNTS AS SOURCE
----------------------------------
1. Its extension is in `SOURCE_EXT`.
2. It has NO extension, exists, and starts with `#!` -- see `is_script`. Added
   2026-09-10 because `~/env-config/bin/` is entirely extensionless, so the
   extension list could never cover the directory holding these hooks; a
   `python3 - <<EOF` rewrite of `bin/glab-mr-approve` was allowed through.

WHAT IS OUT OF SCOPE, and why
-----------------------------
- remote and in-container writes (`ssh …`, `docker exec …`): the file tools
  have no reach there, so steering to them would name an impossible action.
  The credential-rotation pattern in CLAUDE.md § Secret Handling depends on
  exactly this shape.
- targets outside a git work tree: the rules this guard exists to protect live
  in a repo, so there is nothing to load for a file that is not in one. The
  previous version's docstring claimed this limit without implementing it.
- generated artifacts (`git log … > CHANGELOG.md`, `curl … > schema.json`):
  the left side is a producer, not an editor. CLAUDE.md's own test is whether
  a person or a linter reads the result AS SOURCE.
- scratch and process-log paths: `tmp/`, `/tmp/`, scratchpad, `.superpowers/`,
  caches. Blocking a subagent's own task report is pure friction.

NOT A BOUNDARY. It still pattern-matches, so a path assembled at runtime walks
past. It is a nudge toward the tool that loads the rules. Fails open on any
internal error: a guard that crashes must not become a guard that blocks
everything.
"""

import json
import os
import re
import subprocess
import sys

SOURCE_EXT = (
    "py|ts|tsx|js|mjs|cjs|scala|java|sh|bash|zsh|"
    "md|rst|less|css|scss|pug|html|"
    "yaml|yml|json|toml|graphql|gql|sql|jinja2|properties|"
    # Typesetting sources, added 2026-09-07. Omitting them was not a decision --
    # the transcript record shows the family was never considered, while every
    # measurement pass was hunting false positives and therefore only ever
    # narrowing this list. A repo that is mostly .tex was invisible to the deny,
    # and an unanchored `sed -i` silently rewrote the wrong figure's dimensions
    # in os-lecture-notes; only the PostToolUse hint caught it, after the fact.
    "tex|cls|sty|bib|dtx|ins|typ|Rmd|qmd"
)
EXT_RE = r"(?:" + SOURCE_EXT + r")"

# Writes that happen somewhere the file tools cannot reach. Checked first: a
# steer message naming Read+Edit for a path on another host is just wrong.
REMOTE = re.compile(r"^\s*(?:sudo\s+)?(?:ssh|scp|rsync)\b|\b(?:docker|podman|kubectl)\s+(?:compose\s+)?exec\b")

# Producers, for the redirect case. `cat` is deliberately absent -- `cat > f`
# is the canonical heredoc write, not generation.
GENERATOR = {
    "git", "curl", "wget", "jq", "yq", "docker", "kubectl", "helm", "glab", "gh",
    "npm", "yarn", "pnpm", "poetry", "pip", "pip3", "make", "cargo", "go", "sbt",
    "mvn", "gradle", "pytest", "ruff", "black", "mypy", "openssl", "base64",
    "sha256sum", "md5sum", "find", "ls", "env", "printenv", "date", "uname",
    "ps", "df", "du", "systemctl", "journalctl", "dmesg", "kafka-topics.sh",
}

# Paths where a Bash-mediated write is legitimate: scratch, caches, and the
# process-log locations subagents are TOLD to write to.
EXEMPT_PATH = re.compile(
    r"(^|/)(tmp|scratchpad|\.superpowers|node_modules|\.git|__pycache__"
    r"|dist|build|target|out|\.cache|\.venv|venv|site-packages"
    r"|coverage|htmlcov|\.next|\.nuxt|\.svelte-kit|\.pytest_cache|\.mypy_cache)(/|$)"
    r"|^/tmp/|^/var/tmp/|/\.claude/projects/"
)

STEER = (
    "Bash-mediated writes to source files skip the path-scoped rules under "
    ".claude/rules/ -- those load on Read, and Bash never triggers one. "
    "Measured: 40 .py-touching Bash calls in one session produced zero rule "
    "injections.\n"
    "Use Read then Edit for an existing file (Edit hard-fails without the Read, "
    "and that Read is what pulls the rules in), or the Write tool for a new one.\n"
    "Out of scope, so not this: remote/container writes, targets outside a git "
    "work tree, generated artifacts, and scratch paths (tmp/, /tmp/, scratchpad, "
    ".superpowers/)."
)

# --- context splitting -------------------------------------------------------

HEREDOC = re.compile(
    r"<<-?\s*(['\"]?)(?P<tag>[A-Za-z_][A-Za-z0-9_]*)\1(?P<body>.*?)^\s*(?P=tag)\s*$",
    re.S | re.M,
)
INTERPRETER = re.compile(r"\b(?:python3?|bash|sh|zsh|perl|ruby|node)\b\s*-?\s*(?:<<|$|\s)")


def split_context(cmd: str):
    """Return (shell_text, program_texts).

    A heredoc body is a DOCUMENT when the heredoc feeds a file redirect
    (`cat > f <<'EOF'`) and a PROGRAM when it feeds an interpreter
    (`python3 - <<'PY'`). The first must not be scanned for writes -- it is
    content, and scanning it blocked the very report describing this bug. The
    second must be, because that is where the write actually happens.
    """
    programs = []
    shell_parts = []
    pos = 0
    for m in HEREDOC.finditer(cmd):
        head = cmd[pos:m.start()]
        shell_parts.append(head)
        # Does the text introducing this heredoc invoke an interpreter?
        last_segment = re.split(r"[;&|]|&&", head)[-1]
        if INTERPRETER.search(last_segment + " <<"):
            programs.append(m.group("body"))
        pos = m.end()
    shell_parts.append(cmd[pos:])
    shell_text = " ".join(shell_parts)

    # `-c '...'` bodies are programs too.
    for m in re.finditer(r"\b(?:python3?|bash|sh|zsh|perl|ruby|node)\s+-c\s+(['\"])(.*?)\1", cmd, re.S):
        programs.append(m.group(2))
    return shell_text, programs


QUOTED = re.compile(r"'[^']*'|\"[^\"]*\"", re.S)
SHELL_WRAPPER = re.compile(r"\b(?:bash|sh|zsh)\s+-c\s+(['\"])(?P<body>.*?)\1", re.S)


BARE_PATH = re.compile(r"^[\w./~$@{}-]+\." + EXT_RE + r"$")


def _mask_one(m: re.Match) -> str:
    """Blank one quoted literal -- unless it is a quoted PATH.

    Quoting the target is defensive shell, not evasion: `sed -i 's/a/b/'
    "server/app.py"` has the script quoted AND the path quoted. Blanking both
    let five real writes through in regression. So a quoted region whose whole
    content is a bare path with a source extension is preserved (unquoted,
    padded to keep offsets stable); everything else is blanked.
    """
    body = m.group(0)[1:-1]
    if BARE_PATH.match(body):
        return " " + body + " "
    return " " * len(m.group(0))


def mask_quoted(text: str) -> str:
    """Blank quoted literals -- they are arguments, not shell syntax.

    Two exceptions the first version missed. The quoted body of `bash -c '…'`
    IS a command, so it is spliced back in unquoted -- without that, wrapping
    any write in `bash -c` walked straight past. And a quoted path is still a
    path, see :func:`_mask_one`.
    """
    inner = [m.group("body") for m in SHELL_WRAPPER.finditer(text)]
    masked = QUOTED.sub(_mask_one, text)
    return " ; ".join([masked] + inner) if inner else masked


# --- write patterns ----------------------------------------------------------

SHELL_WRITES = [
    # (?<!\\) so an escaped `\>` -- POSIX `[ $a \> $b ]` string comparison --
    # is not read as a redirect. That misfire blocked an `if` statement.
    ("shell redirect", re.compile(r"(?P<pre>^|[;&|])(?P<lhs>[^;&|>]*?)(?<!\\)>>?\s*(?P<path>[^\s;|&>]+\." + EXT_RE + r")\b")),
    ("tee", re.compile(r"\btee\s+(?:-a\s+)?(?P<path>[^\s;|&]+\." + EXT_RE + r")\b")),
    # The gap between the program and its in-place flag must not cross a NEWLINE
    # either. `[^|;]` alone let the pattern stitch a `sed` on one line to an
    # unrelated `-i` further down a multi-line command -- measured 2026-09-10,
    # where `rg -c x f | sed 's/^/h: /'` followed on the next line by
    # `rg -n -i pat CLAUDE.md` was refused as an in-place write. Paired control:
    # the same two statements joined with `;` were allowed, because `;` was
    # already excluded. A multi-line command is the normal shape here, so this
    # fired on ordinary read-only work.
    ("sed -i", re.compile(r"\bsed\b[^|;\n]*?\s(?:-i\b|--in-place\b)[^|;\n]*?(?P<path>[^\s;|&]+\." + EXT_RE + r")\b")),
    ("perl -i", re.compile(r"\bperl\b[^|;\n]*?\s-\w*i\w*\b[^|;\n]*?(?P<path>[^\s;|&]+\." + EXT_RE + r")\b")),
]

# Bind the trigger to the path in the SAME call. The first version matched
# `write_text(` anywhere then scanned for any Path()/open() in the command,
# which named read-only files as the write target and made the steer message
# itself wrong.
PY_WRITES = [
    ("Path.write_text", re.compile(r"Path\s*\(\s*['\"](?P<path>[^'\"]+\." + EXT_RE + r")['\"]\s*\)\s*\.\s*write_text")),
    ("open(...,'w')", re.compile(r"open\s*\(\s*['\"](?P<path>[^'\"]+\." + EXT_RE + r")['\"]\s*,\s*['\"][wa][btx+]*['\"]")),
    ("p.write_text", re.compile(r"(?P<var>\w+)\s*=\s*Path\s*\(\s*['\"](?P<path>[^'\"]+\." + EXT_RE + r")['\"]\s*\)")),
]


# Same shapes again, but for targets with NO file extension. `~/env-config/bin/`
# is entirely extensionless -- every hook there, including this guard -- so the
# extension list could never cover the directory that holds the tooling this
# rule exists to protect. Found 2026-09-10 when a `python3 - <<EOF` with
# `io.open(p,'w')` rewrote `bin/glab-mr-approve` and this guard allowed it; two
# independent reasons let it through, a variable-held path (gap 1, still open)
# and the missing extension, and either alone was enough.
#
# The path group is deliberately broad here, so `is_script` does the narrowing.
# A pattern alone cannot: it would match `> /dev/null`, `tee out`, and every
# other bare redirect target.
SHELL_WRITES_NOEXT = [
    ("shell redirect", re.compile(r"(?P<pre>^|[;&|])(?P<lhs>[^;&|>]*?)(?<!\\)>>?\s*(?P<path>[^\s;|&>]+)")),
    ("tee", re.compile(r"\btee\s+(?:-a\s+)?(?P<path>[^\s;|&]+)")),
    ("sed -i", re.compile(r"\bsed\b[^|;\n]*?\s(?:-i\b|--in-place\b)[^|;\n]*?(?P<path>[^\s;|&]+)")),
    ("perl -i", re.compile(r"\bperl\b[^|;\n]*?\s-\w*i\w*\b[^|;\n]*?(?P<path>[^\s;|&]+)")),
]

PY_WRITES_NOEXT = [
    ("Path.write_text", re.compile(r"Path\s*\(\s*['\"](?P<path>[^'\"]+)['\"]\s*\)\s*\.\s*write_text")),
    ("open(...,'w')", re.compile(r"open\s*\(\s*['\"](?P<path>[^'\"]+)['\"]\s*,\s*['\"][wa][btx+]*['\"]")),
]


def is_script(path: str) -> bool:
    """True for an EXISTING, extensionless regular file that starts with `#!`.

    The shebang is the discriminator, not the name: it is what makes a file
    source rather than data, and it is the only reliable signal once there is no
    extension to consult. Checked in cost order -- string, then stat, then two
    bytes -- because the broad patterns above hand this every redirect target in
    the command, and `in_git_tree` (a subprocess) must run only on survivors.

    Requiring the file to EXIST is a real limitation, stated rather than
    discovered later: creating a NEW extensionless script through a heredoc is
    not caught, because there is nothing yet to read a shebang from. That is
    acceptable here -- the rule exists so that editing a file loads the
    path-scoped rules it is subject to, and a file that does not exist yet has
    no conventions to load. `Write` remains the right tool for a new one.
    """
    base = os.path.basename(path)
    if "." in base:
        return False          # the extension patterns already own this case
    try:
        if not os.path.isfile(path):
            return False
        with open(path, "rb") as fh:
            return fh.read(2) == b"#!"
    except OSError:
        return False


def strip_quotes(p: str) -> str:
    return p.strip().strip("'\"")


def expand_vars(path: str, cmd: str) -> str:
    """Resolve `$VAR` / `${VAR}` from assignments in the same command.

    59% of the first version's false positives were this: `S=/tmp/x; cat >
    $S/f.md` never matched a path-based exemption because the exemption saw the
    unexpanded string. Putting a path in a variable is ordinary shell.
    """
    assigns = dict(re.findall(r"(?:^|[;&\s])([A-Za-z_]\w*)=([^\s;&|]+)", cmd))
    for _ in range(3):  # resolve a couple of levels of indirection
        m = re.search(r"\$\{?([A-Za-z_]\w*)\}?", path)
        if not m or m.group(1) not in assigns:
            break
        path = path[:m.start()] + strip_quotes(assigns[m.group(1)]) + path[m.end():]
    return path


def in_git_tree(path: str) -> bool:
    """True when the target sits inside a git work tree.

    The rules this guard protects live in a repo, so a file outside one has
    nothing to load. Walk up to the nearest existing ancestor, since the target
    itself may not exist yet.
    """
    d = os.path.dirname(os.path.abspath(path)) or "/"
    while not os.path.isdir(d) and d != "/":
        d = os.path.dirname(d)
    try:
        r = subprocess.run(
            ["git", "-C", d, "rev-parse", "--is-inside-work-tree"],
            capture_output=True, text=True, timeout=5,
        )
        return r.returncode == 0 and r.stdout.strip() == "true"
    except Exception:
        return False  # fail open


UNRESOLVED = re.compile(r"\$\(|`|\$\{?\w")


def effective_cwd(shell_text: str, cmd: str) -> str:
    """The directory a RELATIVE target actually lands in.

    A command that `cd`s first and then names a bare filename -- `cd
    /tmp/.../scratchpad && … > scan.json` -- must resolve against that `cd`
    target, not against the hook's own cwd. Resolving against the hook's cwd
    put scratch files inside the repo and produced a fresh batch of false
    positives in regression, which is how this function earned its place.

    Takes SHELL_TEXT, not the raw command: a `cd` inside a heredoc body belongs
    to the document being written, not to this shell. Scanning the raw string
    picked up a `cd "$T/t"` from inside a script being generated and resolved a
    scratch target into the repo -- one surviving false positive, found by
    sampling the newly-caught set rather than by any test case.
    """
    last = None
    for m in re.finditer(r"(?:^|[;&\n]|&&)\s*cd\s+(?P<dir>[^\s;|&]+)", shell_text):
        last = m.group("dir")
    if not last:
        return os.getcwd()
    d = expand_vars(strip_quotes(last), cmd)
    if UNRESOLVED.search(d):
        return os.getcwd()
    d = os.path.expanduser(d)
    return d if os.path.isabs(d) else os.path.join(os.getcwd(), d)


def resolve(path: str, cmd: str, base: str) -> str | None:
    """Absolute target, or None when it cannot be pinned down.

    None means allow. A path still carrying `$(...)`, a backtick, or an
    unresolved variable is one this guard cannot reason about, and guessing
    produced garbage targets like `$(mktemp/block.sh` in regression -- a
    nonsense path in a deny message is worse than no deny at all.
    """
    p = expand_vars(strip_quotes(path), cmd)
    if UNRESOLVED.search(p):
        return None
    p = os.path.expanduser(p)
    if not os.path.isabs(p):
        p = os.path.join(base, p)
    return os.path.normpath(p)


def lhs_is_generator(lhs: str) -> bool:
    toks = [t for t in re.split(r"\s+", lhs.strip()) if t and "=" not in t]
    if not toks:
        return False
    first = os.path.basename(toks[0])
    if first in ("sudo", "timeout", "env", "nice") and len(toks) > 1:
        first = os.path.basename(toks[1])
    return first in GENERATOR


def find_write(cmd: str):
    """Return (rule, resolved_path) for a write this guard should refuse."""
    if REMOTE.search(cmd):
        return None, None

    shell_text, programs = split_context(cmd)
    base = effective_cwd(shell_text, cmd)
    shell_text = mask_quoted(shell_text)

    for name, pat in SHELL_WRITES:
        for m in pat.finditer(shell_text):
            if name == "shell redirect" and lhs_is_generator(m.group("lhs")):
                continue
            p = resolve(m.group("path"), cmd, base)
            if p is None or EXEMPT_PATH.search(p) or not in_git_tree(p):
                continue
            return name, p

    for body in programs:
        for name, pat in PY_WRITES:
            for m in pat.finditer(body):
                if name == "p.write_text":
                    var = m.group("var")
                    if not re.search(rf"\b{re.escape(var)}\s*\.\s*write_text", body):
                        continue
                p = resolve(m.group("path"), cmd, base)
                if p is None or EXEMPT_PATH.search(p) or not in_git_tree(p):
                    continue
                return name, p

    # Second pass: extensionless targets, narrowed by `is_script` rather than by
    # name. Runs after the extension pass so the common case keeps its exact
    # behaviour and message, and `is_script` is checked before `in_git_tree`
    # because the broad patterns feed this every bare redirect target and only
    # the survivors are worth a subprocess.
    for name, pat in SHELL_WRITES_NOEXT:
        for m in pat.finditer(shell_text):
            if name == "shell redirect" and lhs_is_generator(m.group("lhs")):
                continue
            p = resolve(m.group("path"), cmd, base)
            if p is None or not is_script(p):
                continue
            if EXEMPT_PATH.search(p) or not in_git_tree(p):
                continue
            return name + " (extensionless script)", p

    for body in programs:
        for name, pat in PY_WRITES_NOEXT:
            for m in pat.finditer(body):
                p = resolve(m.group("path"), cmd, base)
                if p is None or not is_script(p):
                    continue
                if EXEMPT_PATH.search(p) or not in_git_tree(p):
                    continue
                return name + " (extensionless script)", p
    return None, None


def main() -> None:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        sys.exit(0)

    if payload.get("tool_name") != "Bash":
        sys.exit(0)
    cmd = (payload.get("tool_input") or {}).get("command") or ""
    if not cmd:
        sys.exit(0)

    # NOTE: no cwd short-circuit. The first version exited early when the
    # session cwd matched an exempt path, which silently disabled the whole
    # guard for any session working out of /tmp -- measured to let even
    # absolute-path edits of real repo source through.
    try:
        rule, path = find_write(cmd)
    except Exception:
        sys.exit(0)

    if not rule:
        sys.exit(0)

    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": f"Blocked: {rule} write to {path}.\n\n{STEER}",
        }
    }))


if __name__ == "__main__":
    main()
