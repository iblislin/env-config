#!/usr/bin/env python3
"""Approve a merge request, spending one use of this session's AMToken.

    glab-mr-approve <project>!<iid>        e.g. glab-mr-approve internal-group/latex-common!42

This is the sanctioned way for an agent to approve. The raw `glab mr approve`
carries a `permissions.ask` rule and `glab api *approve*` is denied, because an
`ask` rule cannot be pre-satisfied and therefore stalls an unattended run for as
long as nobody looks -- five hours in the case that prompted this, once a week.
See ~/doc/2026-09-10-unattended-approval-starvation.md.

WHY IT APPROVES AS THE BOT ON `internal-group/*`
--------------------------------------
The first version used plain `glab`, so the approval was recorded as the human.
Reading an MR's own history showed why that is wrong: the note said
`A38767 approved this merge request` -- **identical to the human clicking
Approve in the UI.** GitLab's record could not distinguish a human decision from
an agent spending a ticket, and in this fleet approve is merge.

So two records answer two different questions:

* **who authorised it** -> `am-token`'s audit log, which names the human
* **who acted** -> GitLab, which now names `claude-code-interactive`

Same reasoning as posting comments as that bot rather than as the user, and the
bot holds Developer on `internal-group/*`, which is enough to approve.

**This script therefore handles a credential, and that is a real cost.** Stated
plainly rather than left implicit:

* The token goes into the `glab` subprocess's environment only -- never argv
  (visible in `ps`), never printed, never in an error message.
* `pass show *` carries an `ask` rule, but the permission engine only sees
  `glab-mr-approve <target>`, so it does not prompt. That means **this surrogate
  has credential access the calling agent is gated from**. That is what a
  surrogate is for, and it is also why this file must never grow a debug path
  that echoes the token.
* If `pass` cannot produce it -- a locked gpg-agent, a renamed entry -- the run
  refuses with exit 75 and says so, rather than silently falling back to the
  human's identity. A silent fallback would put the ambiguity back exactly where
  nobody would look for it.
* Only `internal-group/*`: the group access token has no scope on personal-namespace
  projects, so those still use the human's own `glab` config. `glab-mr-watch`
  makes the same distinction.

WHY IT CHECKS THE PIPELINE, AND WHO DECIDES
-------------------------------------------
On `internal-group/*`, `marge-bot-approval-sync` assigns marge-bot the moment approval
lands, so **approve is merge** and it inherits the merge gate.

Whether a pipeline is *required* is the project's call, read from
`only_allow_merge_if_pipeline_succeeds` rather than decided here -- see
`pipeline_gate_ok`. A pipeline that exists and is not `success` refuses either
way; a missing one refuses only where the project requires it. That keeps this
tool aligned with `enforce-pipeline-required.py` (IOT-228) instead of drifting
from it, and usable on the projects that deliberately run no MR CI. Do not quote
a project count from memory here -- it drifts; re-run that script for a current
list.

WHY A DENIAL IS LOUD
--------------------
The motivating failure was discovering hours later that nothing had happened. A
design that fails fast but says nothing only moves the discovery. So a refusal
does four things: exits 75, prints the replacement action, writes a persistent
`blocked` record that `am-token list` reports, and **rings the tmux window's
bell**.

The bell is the part that reaches a human who is not looking. It is the same
mechanism `claude-attn-hook` uses -- write `\a` to `#{pane_tty}`, which sets
tmux's `window_bell_flag`, shows the `!` marker in the window list, and is
cleared only when someone SELECTS that window. Nothing a running agent does
resets it.

**Why not the attention board's state file, which this used to write.** The
board keys its state by tmux window, and `claude-attn-hook` owns that key. The
docstring here first said the entry would survive "until Claude next stops";
measured 2026-09-10, it is overwritten within SECONDS -- the hook rewrites the
key as `running` on ordinary tool activity, not only at a stop. So a `waiting`
entry written by this script is gone before anyone could see it, which defeats
the one requirement that mattered. The board entry is still written, because it
is correct while it lasts and costs nothing, but it is not the notification.

Durable, in order of how likely you are to notice: the bell, then
`am-token list` (the `blocked/` record), then `.attn.log`.

Exit codes: 0 approved · 75 no valid ticket, or the pipeline is not green (both
are "stop and report", not "retry") · 64 usage · 1 other failure.
"""
import fcntl
import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
DIR = os.path.join(HOME, ".claude", "am-tokens")
BLOCKED = os.path.join(DIR, "blocked")
AUDIT = os.path.join(DIR, "audit.log")
ATTN = os.path.join(HOME, ".claude", "tmux-status")
SESSION = (os.environ.get("CLAUDE_CODE_SESSION_ID") or "").strip()
TARGET_RE = re.compile(r"^(?P<project>[\w.\-/]+)!(?P<iid>\d+)$")

GUIDANCE = """\
  Do NOT retry, and do NOT fall back to `glab mr approve` or the REST API --
  both are gated for the same reason and will not get further.
  Report STATUS = BLOCKED, naming this MR and saying an approve ticket is
  needed. A human issues one with `! am-token grant --uses 1`."""


def out(msg):
    sys.stderr.write(msg.rstrip() + "\n")


def audit(event, **fields):
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    row = dict(ts=int(time.time()), iso=time.strftime("%F %T"), event=event,
               session=SESSION, **fields)
    with open(AUDIT, "a", encoding="utf-8") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        fh.write(json.dumps(row, sort_keys=True) + "\n")


def tmux_key():
    """socket__session__window plus the pane's tty, from TMUX_PANE.

    TMUX_PANE is inherited by a process in the pane -- measured identical
    between the Bash tool and the `!` shell. `pane_tty` comes along because the
    bell is written to it directly; see `ring_bell`."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return None
    try:
        fields = subprocess.run(
            ["tmux", "display-message", "-p", "-t", pane,
             "#{socket_path}\t#{session_name}\t#{window_index}\t"
             "#{window_name}\t#{pane_current_path}\t#{pane_tty}"],
            capture_output=True, text=True, timeout=5).stdout.strip().split("\t")
        sock, sess, win, wname, cpath, ptty = fields
    except Exception:
        return None
    safe = lambda s: re.sub(r"[/ \t]", "_", s)
    sockname = os.path.basename(sock)
    return ("%s__%s__%s" % (safe(sockname), safe(sess), safe(win)),
            sess, win, wname, sockname, cpath, ptty)


def ring_bell(ptty):
    """Set this tmux window's bell flag by writing \\a to its tty.

    The same mechanism `claude-attn-hook` uses, and the reason it is the
    notification of record here: tmux's `window_bell_flag` is cleared only when
    someone SELECTS the window, so nothing a running agent does resets it. The
    attention board's state file, by contrast, is rewritten as `running` within
    seconds by ordinary tool activity.

    Best-effort by design -- outside tmux, or with an unwritable tty, a missing
    bell must never turn a refusal into a crash.
    """
    if not ptty:
        return False
    try:
        with open(ptty, "w") as fh:
            fh.write("\a")
        return True
    except OSError:
        return False


def notify(status, label, bell=False):
    """Record the event and, when it needs a human, ring the window's bell.

    Three destinations with different lifetimes, which is the point:

    * the bell -- survives until someone selects the window. `bell=True` only
      for states that actually need attention; a successful approve does not.
    * `.attn.log` -- append-only history, survives everything.
    * the board's state file -- correct while it lasts, and it does not last:
      `claude-attn-hook` rewrites this key as `running` on ordinary tool
      activity within seconds. Written anyway because it costs nothing, but it
      is not what notifies anyone.

    Fields follow claude-attn-hook's own order: ts, status, sess:win, wname,
    sockname, cpath, label.
    """
    key = tmux_key()
    if not key:
        return
    name, sess, win, wname, sockname, cpath, ptty = key
    os.makedirs(ATTN, exist_ok=True)
    row = "\t".join([str(int(time.time())), status, "%s:%s" % (sess, win),
                     wname, sockname, cpath, label])
    rang = ring_bell(ptty) if bell else False
    try:
        with open(os.path.join(ATTN, name), "w", encoding="utf-8") as fh:
            fh.write(row + "\n")
        with open(os.path.join(ATTN, ".attn.log"), "a", encoding="utf-8") as fh:
            fh.write("%s\t%-7s\t%s:%s\t[%s]\t%s%s\n"
                     % (time.strftime("%F %T"), status, sess, win, sockname,
                        label, "" if not bell else (" [bell]" if rang
                                                    else " [bell FAILED]")))
    except OSError:
        pass


def record_blocked(target, reason):
    os.makedirs(BLOCKED, mode=0o700, exist_ok=True)
    with open(os.path.join(BLOCKED, "%s.json" % SESSION), "w", encoding="utf-8") as fh:
        json.dump(dict(ts=int(time.time()), target=target, reason=reason,
                       session=SESSION), fh)
    # bell=True: this is the one state that needs a human who is not looking.
    notify("waiting", "AMToken needed: %s (%s)" % (target, reason), bell=True)
    audit("blocked", target=target, reason=reason)


BOT_ENTRY = "gitlab/internal-group-bot-interactive"


def glab(*args, timeout=60, env=None):
    return subprocess.run(["glab", *args], capture_output=True, text=True,
                          timeout=timeout, env=env)


def bot_env(project):
    """(env, description) for the `glab` call that performs the approval.

    Returns the process environment with GITLAB_TOKEN set to the internal-group bot's
    group access token, so GitLab records the approval as
    `claude-code-interactive` rather than as the human -- see the module
    docstring for why that distinction matters.

    The token is placed in the environment of the child only. Never argv, which
    `ps` exposes to every process on the box, and never returned in the
    description or any error text.

    (None, reason) means refuse. A missing credential must NOT fall back to the
    human's identity: that would restore the exact ambiguity this exists to
    remove, in the one case nobody would think to check.
    """
    if not project.startswith("internal-group/"):
        return dict(os.environ), ("as you: the internal-group bot token has no scope on %s"
                                  % project.split("/", 1)[0])
    try:
        r = subprocess.run(["pass", "show", BOT_ENTRY],
                           capture_output=True, text=True, timeout=30)
    except Exception as e:
        return None, "could not run `pass` (%s)" % type(e).__name__
    token = (r.stdout or "").splitlines()[0].strip() if r.stdout else ""
    if r.returncode != 0 or not token:
        return None, ("`pass show %s` produced nothing (a locked gpg-agent, or a "
                      "renamed entry). Refusing rather than approving as you."
                      % BOT_ENTRY)
    env = dict(os.environ, GITLAB_TOKEN=token)
    return env, "as claude-code-interactive (%d-char bot token)" % len(token)


def pipeline_gate_ok(project, iid):
    """(ok, description). The PROJECT decides whether a pipeline is required.

    The first version refused whenever the head commit had no pipeline. That is
    stricter than the server's own policy and it makes the tool unusable on the
    repos that deliberately run no MR CI -- 40 `internal-group/*` projects were skipped
    for exactly that reason (IOT-228), and `internal-group/agent-chain-e2e` is one, with
    `only_allow_merge_if_pipeline_succeeds = False` and no pipeline on an MR.
    Refusing there would have been my guess overriding the project's decision.

    The risk being guarded is approving BEFORE CI finishes, not approving where
    CI does not exist. So:

    * project requires pipelines -> one must exist AND be `success`. A missing
      pipeline refuses, which also covers the race just after a push.
    * project does not require them -> a missing pipeline is the project's
      accepted state, so allow. A pipeline that EXISTS and is not `success`
      still refuses: approving onto a red run is wrong whatever the policy says.

    Asking the server rather than deciding here also means the answer tracks
    `enforce-pipeline-required.py` instead of drifting from it.
    """
    esc = project.replace("/", "%2F")
    r = glab("api", "projects/%s/merge_requests/%s" % (esc, iid))
    if r.returncode != 0:
        return False, "could not read the MR: %s" % (r.stderr.strip()[:200] or "?")
    try:
        mr = json.loads(r.stdout)
    except ValueError:
        return False, "unparseable MR payload"

    p = glab("api", "projects/%s" % esc)
    required = True          # fail safe if the project cannot be read
    if p.returncode == 0:
        try:
            required = bool(json.loads(p.stdout)
                            .get("only_allow_merge_if_pipeline_succeeds", True))
        except ValueError:
            pass

    pl = mr.get("head_pipeline") or mr.get("pipeline")
    if not pl:
        if required:
            return False, ("no pipeline on the head commit, and this project "
                           "requires one to succeed before merge")
        return True, "project requires no pipeline, and none ran"
    st = pl.get("status")
    if st == "success":
        return True, "head pipeline %s succeeded" % pl.get("id")
    return False, "head pipeline %s is %s" % (pl.get("id"), st)


def spend(target, project, iid):
    """Take the lock, validate, decrement. Returns (ok, reason).

    The lock is not optional: an L3 run dispatches several subagents and they
    share one session id, so two concurrent approvals would read-modify-write
    the same counter and lose a decrement."""
    path = os.path.join(DIR, "%s.json" % SESSION)
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    lock = open(os.path.join(DIR, ".%s.lock" % SESSION), "w")
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    try:
        try:
            with open(path, encoding="utf-8") as fh:
                t = json.load(fh)
        except (OSError, ValueError):
            return False, "no ticket for this session"
        now = int(time.time())
        if t.get("expires_at") and now >= t["expires_at"]:
            return False, "ticket expired"
        if t.get("uses_remaining", 0) <= 0:
            return False, "ticket exhausted (%d of %d used)" % (
                t.get("uses_granted", 0), t.get("uses_granted", 0))
        scope = t.get("scope", "*")
        scopes = scope if isinstance(scope, list) else [scope]
        if "*" not in scopes:
            import fnmatch
            if not any(fnmatch.fnmatch(project, s) for s in scopes):
                return False, "ticket scope %r does not cover %s" % (scopes, project)

        ok, why = pipeline_gate_ok(project, iid)
        if not ok:
            return False, why

        env, who = bot_env(project)
        if env is None:
            return False, who
        r = glab("mr", "approve", str(iid), "-R", project, env=env)
        if r.returncode != 0:
            return False, "glab mr approve failed: %s" % (
                r.stderr.strip()[:300] or r.stdout.strip()[:300] or "?")

        t["uses_remaining"] -= 1
        with open(path, "w", encoding="utf-8") as fh:
            json.dump(t, fh, indent=2, sort_keys=True)
        audit("approve", target=target, uses_remaining=t["uses_remaining"])
        return True, "%s, %d use(s) left" % (who, t["uses_remaining"])
    finally:
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
        lock.close()


def main():
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        out("usage: glab-mr-approve <project>!<iid>")
        out("       e.g. glab-mr-approve internal-group/latex-common!42")
        sys.exit(64)
    m = TARGET_RE.match(sys.argv[1])
    if not m:
        out("not a target: %r -- want <project>!<iid>" % sys.argv[1])
        sys.exit(64)
    if not SESSION:
        out("CLAUDE_CODE_SESSION_ID is unset, so there is no ticket to find.")
        sys.exit(64)

    target = sys.argv[1]
    project, iid = m.group("project"), m.group("iid")

    ok, why = spend(target, project, iid)
    if ok:
        # Consuming a ticket is also worth surfacing: an approval that happened
        # while nobody watched should be visible without reading a log.
        notify("done", "approved %s (%s)" % (target, why))
        print("approved %s -- %s" % (target, why))
        sys.exit(0)

    record_blocked(target, why)
    out("refusing to approve %s: %s" % (target, why))
    out(GUIDANCE)
    sys.exit(75)


if __name__ == "__main__":
    main()
