#!/usr/bin/env python3
"""claude-attn-board [interval]

Single-pane dashboard that collects, across ALL local tmux
sockets/servers (/tmp/tmux-1000-inner*), two kinds of "attention"
signals and refreshes them in place, flicker-free and size-aware:

  1. Claude - from ~/.claude/tmux-status/ (written by claude-attn-hook):
              which window's Claude finished (DONE) or is waiting (WAIT),
              labeled by the session's /rename title (else ai-title).
              The hook rings that window's bell; an entry clears only
              after the bell went 1 -> 0, i.e. you actually SELECTED the
              window. Entries never expire by time (unless ATTN_MAX_AGE).
  2. Bell   - any OTHER tmux window whose bell flag is set (the '!' in the
              title) -- covers every program. Windows already shown in the
              Claude section are not repeated here.

Rendering: curses alternate screen, redrawn in place every refresh tick
or keypress. Every row is clipped to the current terminal width (by
DISPLAY width, see disp_width()); the list is capped to its height with
a "+N more" footer. Both are re-measured each frame (resize-aware).

Usage: claude-attn-board [refresh_seconds]   (default 3)

Env:
  ATTN_GRACE      accepted for compatibility; unused here, same as in
                  the bash original this replaces (see "Port note" below)
  ATTN_MAX_AGE    hard time expiry, seconds; 0 = never expire  (default 0)
  ATTN_AGE_ALERT  unread entries older than this get an urgent (red)
                  dot instead of the normal one, seconds       (default 300)
  ATTN_KEEP       max Claude entries to retain as history; 0 = 4x the
                  terminal height                              (default 0)
  ATTN_ONCE=1     render one frame to stdout and exit (testing; no eviction)
  ATTN_SOCKETS    test-only override: a os.pathsep-separated list of
                  socket paths to use instead of the real
                  /tmp/tmux-1000-inner* set (empty string = none at all).
                  Never set this when running for real.

Inbox model: entries persist as read/unread history, like a mail inbox.
  * unread  = you have not had WM focus on that window since the event
              (claude-attn-focus hooks): shown bold with a bright dot.
  * read    = you looked at it after the event: kept, shown dimmed.
Newest event floats to the top; a status change re-stamps the entry so its
window jumps back to the top. History is capped to ATTN_KEEP; the oldest
entries beyond the cap are evicted.

Threads: entries are GROUPED BY PROJECT (the pane's cwd), like mail
threads -- one header row per project, its windows indented beneath.
Groups order by their newest event. A group with nothing unread and
nothing running is folded to its header (▸); others are open (▾).

Keys:  j/k or arrows    move the cursor between ALL rows (group headers
                        AND entries)
       Enter (header)   toggle that group's fold
       Enter (entry)    jump the real terminal to that tmux window
       space / o        toggle the fold of the cursor row's group
       mouse click      entry row -> jump; header row -> toggle fold
       mouse wheel      scroll the Claude section 3 lines per notch
       a                show all entries (ignore auto-fold), toggle
       g / G            first / last row         q    quit

---- Port note (2026-10, port from the bash original) -------------------
This replaces a 575-line bash version. It was ported once the dashboard
needed a per-ROW cursor with Enter-to-jump and mouse support -- the key
handling, scrolling and width-clipping logic would have doubled again in
bash, and stdlib curses already gives getch+timeout, KEY_RESIZE/KEY_UP,
mouse events and its own diffed redraw for free. The data model is
unchanged: the same state files under ~/.claude/tmux-status/, the same
.viewed/ mtimes and .focus/ files, the same .ratelimit usage cache, the
same cleanup_stale eviction passes. Everything below is split into a
pure CORE section (parsing, grouping, folding, row/cursor/scroll math,
click mapping -- unit-tested without a terminal) and a thin SHELL section
(curses drawing, tmux subprocess calls, the main loop).
"""
import curses
import glob
import os
import re
import shutil
import subprocess
import sys
import time
import unicodedata
from collections import namedtuple

# =============================================================================
# CORE -- pure functions (plus simple, injectable file/subprocess I/O so
# tests can exercise this section against temp directories or fake
# callables, never the real ~/.claude/tmux-status or a real tmux server).
# =============================================================================

Entry = namedtuple(
    "Entry", "key ts status sess_win wname sockname cpath label outer"
)

_TS_RE = re.compile(r"\d+")


def parse_state_entry(key, raw_text):
    """Parse one claude-attn-hook state-file line into an Entry, or None
    when the line is unusable (empty/garbage timestamp).

    Fields (tab-separated): ts status sess:win wname sockname cpath label
    outer -- 8 fields on current hook output; older files only have 7
    (no trailing outer field), which this treats as outer="".
    """
    line = raw_text.split("\n", 1)[0]
    fields = line.split("\t")
    if len(fields) == 7:
        fields = fields + [""]
    if len(fields) != 8:
        return None
    ts_s, status, sess_win, wname, sockname, cpath, label, outer = fields
    if not _TS_RE.fullmatch(ts_s):
        return None
    return Entry(key, int(ts_s), status, sess_win, wname, sockname, cpath,
                 label, outer)


def split_session_window(sess_win):
    """'a.b:c:3' -> ('a.b:c', '3'); split on the LAST ':' since a tmux
    session name may itself contain ':'. None when there is no ':'."""
    if ":" not in sess_win:
        return None
    session, window = sess_win.rsplit(":", 1)
    return session, window


def safe_component(s):
    return re.sub(r"[/ \t]", "_", s)


def make_key(sockname, sess, win):
    return "%s__%s__%s" % (safe_component(sockname), safe_component(sess),
                            safe_component(win))


def is_socket(path):
    try:
        import stat
        return stat.S_ISSOCK(os.stat(path).st_mode)
    except OSError:
        return False


def list_sockets():
    """The sockets to scan. ATTN_SOCKETS (os.pathsep-separated; may be an
    empty string for "none") overrides the real /tmp/tmux-1000-inner* set
    -- tests set it so the board never opens a real tmux server."""
    override = os.environ.get("ATTN_SOCKETS")
    if override is not None:
        candidates = [p for p in override.split(os.pathsep) if p]
    else:
        base = "/tmp/tmux-1000-inner"
        candidates = [base] + sorted(glob.glob(base + "-*"))
    return [p for p in candidates if is_socket(p)]


def resolve_socket(sockname, sockets):
    """The socket path among `sockets` whose basename equals `sockname`."""
    for s in sockets:
        if os.path.basename(s) == sockname:
            return s
    return None


def fmt_age(age):
    """Human age: 42s / 5m / 3h / 2d."""
    a = int(age)
    if a < 60:
        return "%ds" % a
    if a < 3600:
        return "%dm" % (a // 60)
    if a < 86400:
        return "%dh" % (a // 3600)
    return "%dd" % (a // 86400)


def fmt_countdown(target, now):
    """Countdown to a future unix ts: 2h14m / 45m / 3d4h ('' if past/invalid)."""
    try:
        target_i = int(float(target))
    except (TypeError, ValueError):
        return ""
    diff = target_i - now
    if diff <= 0:
        return ""
    d, rem = divmod(diff, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d > 0:
        return "%dd%dh" % (d, h)
    if h > 0:
        return "%dh%02dm" % (h, m)
    if m < 1:
        m = 1
    return "%dm" % m


def char_width(ch):
    """Display columns for one character: 2 for CJK/fullwidth, 1
    otherwise. The board's emoji icons (✅⏳🔔) already report 'W' from
    unicodedata.east_asian_width in this Python's Unicode Character
    Database (verified directly), so no separate emoji special-case is
    needed -- one fewer thing that can silently drift out of sync with a
    future UCD revision."""
    eaw = unicodedata.east_asian_width(ch)
    return 2 if eaw in ("W", "F") else 1


def disp_width(s):
    return sum(char_width(c) for c in s)


def clip(s, n):
    """Clip `s` to at most `n` display columns, adding an ellipsis when
    truncated. n < 1 -> ''. Never splits a wide character in half."""
    if n < 1:
        return ""
    if disp_width(s) <= n:
        return s
    out = []
    total = 0
    for ch in s:
        w = char_width(ch)
        if total + w > n:
            break
        out.append(ch)
        total += w
    while out and total + 1 > n:
        total -= char_width(out.pop())
    out.append("…")
    return "".join(out)


def pad(s, n):
    """Right-pad `s` with spaces to exactly `n` display columns (assumes
    disp_width(s) <= n already)."""
    w = disp_width(s)
    if w < n:
        return s + " " * (n - w)
    return s


def clip_pad(s, n):
    """clip() then pad(): exactly n display columns, every time -- this is
    what keeps the age column aligned across rows with CJK/mixed names."""
    return pad(clip(s, n), n)


def tilde(path, home=None):
    home = home if home is not None else os.path.expanduser("~")
    if path == home:
        return "~"
    if path.startswith(home + "/"):
        return "~" + path[len(home):]
    return path


def classify_entry(entry, now, viewed_ts, age_alert):
    """running / unread / read, plus age and (for unread) whether it has
    aged past ATTN_AGE_ALERT."""
    age = now - entry.ts
    if entry.status == "running":
        return {"kind": "running", "age": age}
    if viewed_ts < entry.ts:
        return {"kind": "unread", "age": age, "alert": age >= age_alert}
    return {"kind": "read", "age": age}


def build_groups(entries, now, viewed_ts_map, age_alert):
    """Group entries by cpath ("project thread"), groups ordered by their
    newest event, entries within a group ordered ts-desc. Returns a list
    of dicts: cpath, newest, entries (list of (Entry, classification)),
    unread/read/run counts."""
    ordered = sorted(entries, key=lambda e: -e.ts)
    order = []
    newest = {}
    bucket = {}
    counts = {}
    for e in ordered:
        cls = classify_entry(e, now, viewed_ts_map.get(e.key, 0), age_alert)
        if e.cpath not in newest:
            order.append(e.cpath)
            newest[e.cpath] = e.ts
            bucket[e.cpath] = []
            counts[e.cpath] = {"unread": 0, "read": 0, "run": 0}
        bucket[e.cpath].append((e, cls))
        bucket_key = {"running": "run", "unread": "unread",
                      "read": "read"}[cls["kind"]]
        counts[e.cpath][bucket_key] += 1
    groups = []
    for cp in order:
        c = counts[cp]
        groups.append({"cpath": cp, "newest": newest[cp],
                        "entries": bucket[cp], "unread": c["unread"],
                        "read": c["read"], "run": c["run"]})
    return groups


def auto_fold(group):
    """A group with nothing unread and nothing running folds by default."""
    return not (group["unread"] > 0 or group["run"] > 0)


def resolve_fold(group, show_all, fold_ovr):
    """Effective fold state for `group`. A manual override in fold_ovr
    (cpath -> (ts_at_toggle, folded_bool)) sticks until a NEWER event
    lands in that group, at which point it is expired (removed from
    fold_ovr) and the auto rule applies again."""
    folded = False if show_all else auto_fold(group)
    ovr = fold_ovr.get(group["cpath"])
    if ovr is not None:
        ts_at_toggle, folded_ovr = ovr
        if ts_at_toggle >= group["newest"]:
            folded = folded_ovr
        else:
            del fold_ovr[group["cpath"]]
    return folded


def toggle_group_fold(group, folded_now, fold_ovr):
    """Record a manual fold toggle for `group`, stamped with its current
    newest-event ts so resolve_fold() can tell a later, newer event apart
    from this same toggle."""
    fold_ovr[group["cpath"]] = (group["newest"], not folded_now)


def build_rows(groups, show_all, fold_ovr):
    """The flat, visible row list for the Claude section: one header row
    per group, followed by its entries unless the group is folded."""
    rows = []
    for g in groups:
        folded = resolve_fold(g, show_all, fold_ovr)
        rows.append({"kind": "header", "cpath": g["cpath"], "key": None,
                      "group": g, "folded": folded})
        if not folded:
            for e, cls in g["entries"]:
                rows.append({"kind": "entry", "cpath": g["cpath"],
                              "key": e.key, "entry": e, "cls": cls})
    return rows


def row_id(row):
    if row["kind"] == "header":
        return ("header", row["cpath"])
    return ("entry", row["key"])


def cursor_id_for_row(row):
    """The cursor identity to persist for `row` across a refresh: what
    `locate_cursor()` expects as `last` next time. A header's identity is
    just its cpath; an entry's also carries its group's cpath, so a
    vanished entry can still fall back to that group's header."""
    if row["kind"] == "header":
        return row_id(row)
    return row_id(row) + (row["cpath"],)


def locate_cursor(rows, last, prev_idx=0):
    """Find the row index the cursor belongs on after a refresh.

    `last` is the previous cursor's identity: None, ("header", cpath) or
    ("entry", key, cpath) (the cpath is kept so an entry that has since
    vanished can still fall back to ITS group's header). When nothing
    matches at all (the entry AND its group are both gone, or the cursor
    was never set), falls back to `prev_idx` clamped into the new valid
    range -- NOT 0, so a row vanishing from the middle of a long list
    does not fling the cursor back to the top."""
    if not rows:
        return 0
    if last is not None:
        if last[0] == "header":
            for i, r in enumerate(rows):
                if row_id(r) == ("header", last[1]):
                    return i
        elif last[0] == "entry":
            for i, r in enumerate(rows):
                if row_id(r) == ("entry", last[1]):
                    return i
            # the entry is gone -- fall back to its group's header
            cpath = last[2] if len(last) > 2 else None
            if cpath is not None:
                for i, r in enumerate(rows):
                    if row_id(r) == ("header", cpath):
                        return i
    return max(0, min(prev_idx, len(rows) - 1))


def follow_cursor(idx, scroll, avail, total):
    """Scroll just enough to keep row `idx` visible (cursor-driven;
    mirrors the bash original's follow-the-cursor formula)."""
    if total <= avail:
        return 0
    if idx < scroll + 1:
        scroll = idx - 1
    if idx > scroll + avail - 2:
        scroll = idx - avail + 2
    scroll = min(scroll, total - avail)
    return max(0, scroll)


def scroll_wheel(scroll, delta, total, avail):
    """Move the scroll offset by a wheel notch (delta in rows, negative =
    up), clamped to [0, total-avail]."""
    max_scroll = max(0, total - avail)
    return max(0, min(scroll + delta, max_scroll))


def clamp_cursor_to_view(idx, scroll, avail, total):
    """After a wheel scroll, move the cursor the minimum amount needed to
    stay inside the (marker-aware) visible window."""
    if total <= avail:
        return idx
    hidden_below = total - scroll - avail
    lo = scroll + 1 if scroll > 0 else scroll
    hi = scroll + avail - 1 - (1 if hidden_below > 0 else 0)
    if idx < lo:
        idx = lo
    if idx > hi:
        idx = hi
    return idx


def _default_marker(text):
    return {"kind": "marker", "text": text}


def windowed_rows(rows, scroll, avail, make_marker=None):
    """Slice `rows` to the visible window, replacing the first/last slot
    with a "+N more" marker item when there is more above/below (same
    trade-off as the bash original: that slot's own row is not shown
    alongside the marker). `make_marker(text)` builds the replacement
    item; the default produces a {"kind": "marker", "text": ...} row dict
    for the row-cursor tests, but build_frame passes one that builds a
    (segs, action) pair instead, so the SAME windowing logic serves both
    the pure row model and the rendered-line layout (single
    implementation, per the house review)."""
    make_marker = make_marker or _default_marker
    total = len(rows)
    if total <= avail or avail <= 0:
        return list(rows), 0
    hidden_above = scroll
    hidden_below = total - scroll - avail
    view = list(rows[scroll:scroll + avail])
    if hidden_above > 0 and view:
        view[0] = make_marker("↑ %d more" % hidden_above)
    if hidden_below > 0 and view:
        view[-1] = make_marker("↓ %d more" % hidden_below)
    return view, scroll


# ---- row rendering: segments are (text, style_name_or_None) -------------

ICON = {
    "running": ("▶ RUN  ", "cyan"),
    "waiting": ("⏳ WAIT", "yellow_bold"),
    "done": ("✅ DONE", "green_bold"),
}


def entry_meta_text(entry):
    if entry.outer:
        return "[%s ⇐ %s]" % (entry.sess_win, entry.outer)
    return "[%s]" % entry.sess_win


def render_entry_segs(entry, cls, cursor_here, namecap, metacap):
    name_raw = entry.label or entry.wname
    name = clip_pad(name_raw, namecap)
    meta = clip(entry_meta_text(entry), metacap) if metacap >= 8 else ""
    icon_text, icon_style = ICON.get(entry.status, (entry.status, None))
    age = fmt_age(cls["age"])
    kind = cls["kind"]

    if kind == "running":
        dot_seg = ("▸ ", "cyan")
        name_style = None
    elif kind == "unread":
        dot_style = "red_bold" if cls.get("alert") else "cyan_bold"
        dot_seg = ("● ", dot_style)
        name_style = "bold"
    else:
        dot_seg = ("○ ", "dim")
        icon_text, icon_style = icon_text, "dim"
        name_style = "dim"

    indent = ("> ", "cursor") if cursor_here else ("  ", None)
    return [indent, dot_seg, (icon_text, icon_style), ("  ", None),
            (name, name_style), (" %5s  " % age, None), (meta, "dim")]


def render_header_segs(group, cursor_here, folded, hdrcap, now):
    cur = (">", "cursor") if cursor_here else (" ", None)
    fold_glyph = "▸" if folded else "▾"
    name = clip_pad(tilde(group["cpath"]), hdrcap)
    cnt = []
    if group["unread"] > 0:
        cnt.append(("●%-2d " % group["unread"], "cyan_bold"))
    else:
        cnt.append(("    ", None))
    if group["run"] > 0:
        cnt.append(("▶%-2d " % group["run"], "cyan"))
    else:
        cnt.append(("    ", None))
    cnt.append(("○%-2d" % group["read"], "dim"))
    age = fmt_age(now - group["newest"])
    return [cur, (fold_glyph, None), (" ", None), (name, "bold"),
            ("  ", None)] + cnt + [("  %5s" % age, None)]


def render_marker_segs(text):
    return [("   ", None), (text, "dim")]


def plain_text(segs):
    return "".join(t for t, _ in segs)


_ANSI = {
    None: "", "reset": "\033[0m", "bold": "\033[1m", "dim": "\033[2m",
    "cyan": "\033[36m", "cyan_bold": "\033[1;36m",
    "yellow_bold": "\033[1;33m", "green_bold": "\033[1;32m",
    "red_bold": "\033[1;31m", "magenta_bold": "\033[1;35m",
    "cursor": "\033[1;33m",
}


def render_ansi(segs):
    out = []
    for text, style in segs:
        if not text:
            continue
        if style:
            out.append(_ANSI.get(style, "") + text + _ANSI["reset"])
        else:
            out.append(text)
    return "".join(out)


def row_geometry(width):
    namecap = min(30, max(8, width // 3))
    metacap = width - namecap - 22
    return namecap, metacap


def header_geometry(width):
    return max(8, width - 26)


def render_rows(rows, cursor_idx, namecap, metacap, hdrcap, now):
    """rows (as built by build_rows) -> (segs_per_row, row_actions), both
    aligned 1:1 with `rows`. row_actions[i] is ("header", cpath, None) or
    ("entry", cpath, key)."""
    out_segs = []
    out_actions = []
    for i, r in enumerate(rows):
        here = (i == cursor_idx)
        if r["kind"] == "header":
            out_segs.append(render_header_segs(r["group"], here,
                                                 r["folded"], hdrcap, now))
            out_actions.append(("header", r["cpath"], None))
        else:
            out_segs.append(render_entry_segs(r["entry"], r["cls"], here,
                                                namecap, metacap))
            out_actions.append(("entry", r["cpath"], r["key"]))
    return out_segs, out_actions


# ---- key / click handling ------------------------------------------------

def handle_key(key, rows, idx):
    """Pure core of a keypress: returns (new_idx, action). `action` is
    None, or one of:
      {"type": "toggle", "cpath": ...}
      {"type": "jump", "cpath": ..., "key": ...}
      {"type": "show_all"}
      {"type": "quit"}
    """
    n = len(rows)
    if key in ("j", "DOWN"):
        return (min(idx + 1, n - 1) if n else 0), None
    if key in ("k", "UP"):
        return (max(idx - 1, 0) if n else 0), None
    if key == "g":
        return 0, None
    if key == "G":
        return (n - 1 if n else 0), None
    if n == 0:
        if key == "a":
            return 0, {"type": "show_all"}
        if key == "q":
            return 0, {"type": "quit"}
        return 0, None
    row = rows[idx]
    if key == "ENTER":
        if row["kind"] == "header":
            return idx, {"type": "toggle", "cpath": row["cpath"]}
        return idx, {"type": "jump", "cpath": row["cpath"], "key": row["key"]}
    if key in (" ", "o"):
        return idx, {"type": "toggle", "cpath": row["cpath"]}
    if key == "a":
        return idx, {"type": "show_all"}
    if key == "q":
        return idx, {"type": "quit"}
    return idx, None


def handle_click(y, row_actions):
    """y: absolute line index into the rendered Claude-section lines
    (already mapped through the current scroll offset by whoever built
    row_actions). Returns an action dict (see handle_key) or None."""
    if y < 0 or y >= len(row_actions):
        return None
    ra = row_actions[y]
    if ra is None:
        return None
    kind, cpath, key = ra
    if kind == "header":
        return {"type": "toggle", "cpath": cpath}
    if kind == "entry":
        return {"type": "jump", "cpath": cpath, "key": key}
    return None


# ---- jump --------------------------------------------------------------

def jump_target_for_entry(entry, sockets):
    """(socket_path, session, window) for `entry`, or None when the
    socket/format cannot be resolved."""
    socket = resolve_socket(entry.sockname, sockets)
    if socket is None:
        return None
    sw = split_session_window(entry.sess_win)
    if sw is None:
        return None
    session, window = sw
    return socket, session, window


def find_jump_executable(board_path, which_fn=None):
    """claude-attn-jump next to this script's REAL path, falling back to
    PATH. None if neither has it."""
    which_fn = which_fn or shutil.which
    real_dir = os.path.dirname(os.path.realpath(board_path))
    candidate = os.path.join(real_dir, "claude-attn-jump")
    if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
        return candidate
    return which_fn("claude-attn-jump")


def run_jump(executable, socket, session, window, run_fn=None):
    """Run claude-attn-jump with inherited stdio (never captured -- see
    claude-attn-jump's run_exec_default docstring: tmux's own "current
    client" resolution for switch-client/select-window needs the
    invoking process's real tty on its fds, which capture_output would
    break). Returns the process return code; never raises."""
    run_fn = run_fn or (lambda argv: subprocess.run(argv))
    try:
        p = run_fn([executable, socket, session, window])
        return getattr(p, "returncode", 1)
    except OSError:
        return 1


# ---- state-dir I/O (real files, but the path is always a parameter --
# tests point it at a temp dir, never at ~/.claude/tmux-status) ----------

def list_state_files(state_dir):
    """[(key, raw_text), ...] for each regular, non-dotfile entry
    directly under state_dir. Mirrors the bash original's plain `*`
    glob (no dotglob, so .focus/.viewed/.ratelimit/.attn.log are already
    excluded) plus its `[ -f ]` filter, which is what skips the
    subdirectories other tools keep here (ctx/, tasks/, task-carry/)."""
    try:
        names = os.listdir(state_dir)
    except OSError:
        return []
    out = []
    for name in sorted(names):
        if name.startswith("."):
            continue
        path = os.path.join(state_dir, name)
        if not os.path.isfile(path):
            continue
        try:
            with open(path, "r", errors="replace") as f:
                raw = f.read()
        except OSError:
            continue
        out.append((name, raw))
    return out


def read_viewed_ts(viewed_dir, key):
    try:
        return int(os.stat(os.path.join(viewed_dir, key)).st_mtime)
    except OSError:
        return 0


def cleanup_stale(state_dir, viewed_dir, window_exists_keys,
                   answered_sockets, now, max_age, cap):
    """Inbox upkeep, 3 passes (mirrors the bash original, plus the
    answered_sockets guard the bash original lacked):
      1. drop entries for windows that no longer exist (ONLY when their
         socket actually answered the query -- see list_window_keys), or
         past MAX_AGE, or with an unparsable ts
      2. evict the oldest entries beyond the history cap
      3. prune orphan .viewed/ stamps (no matching inbox entry left)

    `answered_sockets` is the set of socknames whose list-windows query
    succeeded this refresh (from list_window_keys). An entry whose
    sockname is NOT in it is kept regardless of `window_exists_keys` --
    a socket that failed to answer must never look like "all its windows
    are gone", or a single flaky tmux server would mass-delete entries
    that are still perfectly live.
    """
    cap = max(cap, 1)
    survivors = []
    for name, raw in list_state_files(state_dir):
        path = os.path.join(state_dir, name)
        entry = parse_state_entry(name, raw)
        if entry is None:
            _try_remove(path)
            continue
        if max_age > 0 and (now - entry.ts) >= max_age:
            _try_remove(path)
            continue
        if entry.sockname in answered_sockets and name not in window_exists_keys:
            _try_remove(path)
            continue
        survivors.append((entry.ts, name, path))
    survivors.sort(key=lambda t: -t[0])
    for ts, name, path in survivors[cap:]:
        _try_remove(path)
    kept = {name for _, name, _ in survivors[:cap]}
    try:
        viewed_names = os.listdir(viewed_dir)
    except OSError:
        viewed_names = []
    for name in viewed_names:
        if name not in kept:
            _try_remove(os.path.join(viewed_dir, name))


def _try_remove(path):
    try:
        os.remove(path)
    except OSError:
        pass


def dedupe_bells(bell_rows, existing_keys):
    """bell_rows: [(sockname, sess, win, wname), ...] -- drop any row
    whose computed key is already shown in the Claude section."""
    out = []
    for sockname, sess, win, wname in bell_rows:
        key = make_key(sockname, sess, win)
        if key in existing_keys:
            continue
        out.append((sockname, sess, win, wname))
    return out


def list_bell_windows(sockets, run_query):
    """[(sockname, sess, win, wname), ...] for every window with its tmux
    bell flag set, across `sockets`. `run_query` is injectable so tests
    never touch a real tmux server."""
    rows = []
    for s in sockets:
        sockname = os.path.basename(s)
        p = run_query(["tmux", "-S", s, "list-windows", "-a", "-f",
                        "#{window_bell_flag}", "-F",
                        "#{session_name}\t#{window_index}\t#{window_name}"])
        if getattr(p, "returncode", 1) != 0:
            continue
        for line in p.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) != 3:
                continue
            sess, win, wname = parts
            rows.append((sockname, sess, win, wname))
    return rows


def list_window_keys(sockets, run_query):
    """(keys, answered_sockets): `keys` is the set of keys for every
    window that currently exists, across `sockets`; `answered_sockets`
    is the set of socknames whose query actually SUCCEEDED. The split
    matters: a socket whose query failed (tmux server not responding, a
    transient hiccup) must never be treated as "every window on it is
    gone" -- that is cleanup_stale's job, and it needs this distinction
    to avoid mass-deleting entries just because one tmux server had a
    bad moment."""
    keys = set()
    answered = set()
    for s in sockets:
        sockname = os.path.basename(s)
        p = run_query(["tmux", "-S", s, "list-windows", "-a", "-F",
                        "#{session_name}\t#{window_index}"])
        if getattr(p, "returncode", 1) != 0:
            continue
        answered.add(sockname)
        for line in p.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) != 2:
                continue
            sess, win = parts
            keys.add(make_key(sockname, sess, win))
    return keys, answered


def list_client_ttys(sockets, run_query):
    """{client_tty: socket_path} for every attached client across
    `sockets` -- the tty-to-socket map refresh_viewed() needs to resolve
    a .focus/ file's tty back to the server it belongs to."""
    tty_sock = {}
    for s in sockets:
        p = run_query(["tmux", "-S", s, "list-clients", "-F",
                        "#{client_tty}"])
        if getattr(p, "returncode", 1) != 0:
            continue
        for line in p.stdout.splitlines():
            tty = line.strip()
            if tty:
                tty_sock[tty] = s
    return tty_sock


def read_focus_files(focus_dir):
    """[(filename, tty_content), ...] for each file directly under
    focus_dir (written by claude-attn-focus; the content is a tty
    path)."""
    try:
        names = os.listdir(focus_dir)
    except OSError:
        return []
    out = []
    for name in sorted(names):
        path = os.path.join(focus_dir, name)
        try:
            with open(path) as f:
                tty = f.read().strip()
        except OSError:
            continue
        out.append((name, tty))
    return out


def _touch(path):
    try:
        with open(path, "a"):
            pass
        os.utime(path, None)
    except OSError:
        pass


def refresh_viewed(focus_dir, viewed_dir, sockets, run_query):
    """Port of the bash original's refresh_viewed(): the window you are
    ACTUALLY looking at is the current window of every tmux client that
    has WM focus right now (tracked via claude-attn-focus's .focus/
    files, since the pollable client_flags 'focused' token gets stuck).
    For each .focus/ file: read the tty it names; if that tty (or its
    socket) no longer exists, the focused client is gone -- prune the
    stale .focus file. Otherwise, ask that client's tty what window it
    is CURRENTLY displaying, and touch .viewed/<key> for it, which is
    what later marks that window's Claude entry "read".

    Returns the set of keys touched (mostly useful to tests)."""
    tty_sock = list_client_ttys(sockets, run_query)
    touched = set()
    for name, tty in read_focus_files(focus_dir):
        path = os.path.join(focus_dir, name)
        sock = tty_sock.get(tty)
        if not tty or not sock:
            _try_remove(path)  # focused client gone -> prune
            continue
        sockname = os.path.basename(sock)
        p = run_query(["tmux", "-S", sock, "display-message", "-p", "-c",
                        tty, "-F",
                        "%s__#{session_name}__#{window_index}" % sockname])
        if getattr(p, "returncode", 1) != 0:
            continue
        key = p.stdout.strip()
        if key:
            touched.add(key)
    for key in touched:
        _touch(os.path.join(viewed_dir, key))
    return touched


# ---- usage gauge (mirrors the /statusline build_mini style) -------------

def compute_gauge(pct):
    filled = max(0, min(10, pct // 10))
    empty = 10 - filled
    if pct < 50:
        style = "low"
    elif pct < 80:
        style = "mid"
    else:
        style = "high"
    return filled, empty, style


def read_ratelimit_cache(path):
    try:
        with open(path) as f:
            line = f.readline()
    except OSError:
        return None
    parts = line.rstrip("\n").split("\t")
    if len(parts) < 5:
        return None
    upd, fp, fr, wp, wr = parts[:5]

    def to_pct(s):
        s = s.split(".")[0]
        return int(s) if re.fullmatch(r"\d+", s) else None

    fp_i, wp_i = to_pct(fp), to_pct(wp)
    if fp_i is None and wp_i is None:
        return None
    try:
        upd_i = int(float(upd))
    except (TypeError, ValueError):
        upd_i = None
    return {"upd": upd_i, "fp": fp_i, "fr": fr, "wp": wp_i, "wr": wr}


def _mini_segs(label, pct, reset_ts, now):
    filled, empty, style = compute_gauge(pct)
    color = {"low": "low", "mid": "mid", "high": "high"}[style]
    bar = "█" * filled + "░" * empty
    cd = fmt_countdown(reset_ts, now) if reset_ts not in (None, "") else ""
    plain = "%s: [%s] %d%%" % (label, bar, pct)
    segs = [("%s:" % label, "qlabel"), (" [", "dim"), (bar[:filled], color),
            (bar[filled:], "empty"), ("]", "dim"), (" %d%%" % pct, color)]
    if cd:
        plain += " ↻%s" % cd
        segs.append((" ↻%s" % cd, color))
    return plain, segs


def render_usage_segments(cache, width, now):
    """(plain, segs) for the usage line, or None when the cache is
    absent/unusable. Falls back to a compact "5h NN% 7d NN%" form when
    the full gauge would not fit `width`."""
    if cache is None:
        return None
    plain_parts = []
    segs_parts = []
    if cache["fp"] is not None:
        p, s = _mini_segs("5h", cache["fp"], cache.get("fr"), now)
        plain_parts.append(p)
        segs_parts.append(s)
    if cache["wp"] is not None:
        p, s = _mini_segs("7d", cache["wp"], cache.get("wr"), now)
        plain_parts.append(p)
        segs_parts.append(s)
    if not plain_parts:
        return None
    stale = ""
    if cache.get("upd") is not None:
        age = now - cache["upd"]
        if age >= 120:
            stale = "  ⟳%s ago" % fmt_age(age)
    plain_full = "  ".join(plain_parts) + stale
    if disp_width(plain_full) <= width:
        segs = []
        for i, s in enumerate(segs_parts):
            if i:
                segs.append(("  ", None))
            segs.extend(s)
        if stale:
            segs.append((stale, "dim"))
        return plain_full, segs
    compact_plain = "  ".join(
        "%s %d%%" % (("5h" if cache["fp"] is not None and i == 0 else "7d"),
                      (cache["fp"] if cache["fp"] is not None and i == 0
                       else cache["wp"]))
        for i in range(len(plain_parts)))
    if disp_width(compact_plain) <= width:
        return compact_plain, [(compact_plain, None)]
    clipped = clip(compact_plain, width)
    return clipped, [(clipped, None)]


# =============================================================================
# SHELL -- curses drawing, tmux subprocess calls, the main loop. Thin: it
# delegates every decision above to the CORE functions.
# =============================================================================

STATE_SUBDIR = os.path.join(".claude", "tmux-status")


def state_dir():
    return os.path.join(os.path.expanduser("~"), *STATE_SUBDIR.split(os.sep))


def fmt_interval(value):
    """Display text for a refresh interval: "3" for a whole number,
    "1.5" when it has a fraction -- never bash-float noise like "3.0"."""
    v = float(value)
    if v == int(v):
        return "%d" % int(v)
    return ("%g" % v)


def clamp_interval(value, minimum=0.5, default=3.0):
    """Parse `value` as a refresh interval, clamped to at least
    `minimum` seconds so `claude-attn-board 0` (or a negative/garbage
    argument) cannot busy-loop. Unparsable input falls back to
    `default`, matching the bash original's `${1:-3}` behavior for a
    missing argument."""
    try:
        v = float(value)
    except (TypeError, ValueError):
        v = default
    return max(minimum, v)


def build_bell_section(bell_rows, width):
    """The Bell section's full, UNTRUNCATED set of rendered lines
    (heading first), used both to decide the layout budget and, when it
    doesn't fit, to be truncated by build_frame."""
    lines = [[(" Bell (other windows)", "magenta_bold")]]
    if not bell_rows:
        lines.append([("   ", None), ("(none)", "dim")])
    else:
        for sockname, sess, win, wname in bell_rows:
            text = clip("%s:%s %s  [%s]" % (sess, win, wname, sockname),
                         max(1, width - 6))
            lines.append([("   ", None), ("\U0001f514", "red_bold"),
                           ("  ", None), (text, None)])
    return lines


def build_frame(groups, now, show_all, fold_ovr, cursor, prev_idx, scroll,
                 width, height, interval, usage_cache, bell_rows,
                 status_msg):
    """Assemble one full frame from already-gathered data (see
    gather_refresh() for the I/O that produces `groups`/`bell_rows`/
    `usage_cache`) -- this function itself does no I/O, so a key or
    mouse event between full refreshes can call it directly against the
    cached data instead of re-reading state files.

    Returns a dict: `lines` (list of seg-lists), `row_actions` (aligned
    1:1 with `lines`; None outside the Claude section's clickable rows),
    `claude_start` (the line index the Claude section begins at),
    `claude_avail` (how many of those lines are the Claude section's OWN
    rows -- NOT counting the Bell section that follows; wheel scrolling
    must use this, never "everything after claude_start"), new `cursor`
    id, new `scroll`, `groups`, `rows` (the full, unwindowed row list)
    and `idx` (the cursor's index into `rows`)."""
    namecap, metacap = row_geometry(width)
    hdrcap = header_geometry(width)
    rows = build_rows(groups, show_all, fold_ovr)
    idx = locate_cursor(rows, cursor, prev_idx)
    if rows:
        idx = max(0, min(idx, len(rows) - 1))

    lines = []
    row_actions_head = []

    ts = time.strftime("%H:%M:%S")
    hint = ("(every %ss · j/k move · Enter jump/fold · "
            "click · a all · q quit)") % fmt_interval(interval)
    title_text = " tmux attention board "
    if disp_width(title_text) + disp_width(ts) + 2 + disp_width(hint) > width:
        hint = "(every %ss)" % fmt_interval(interval)
    lines.append([(title_text, "bold"), (ts, None), ("  ", None),
                   (hint, "dim")])
    row_actions_head.append(None)

    if status_msg:
        lines.append([(status_msg, "red_bold")])
        row_actions_head.append(None)

    usage = render_usage_segments(usage_cache, width, now)
    if usage is not None:
        lines.append([(" ", None)] + usage[1])
        row_actions_head.append(None)

    lines.append([(clip(" " + "─" * 73, width), "dim")])
    row_actions_head.append(None)
    lines.append([(" Claude", "cyan_bold"), ("  (grouped by project cwd)",
                                               "dim")])
    row_actions_head.append(None)

    claude_start = len(lines)
    head_h = claude_start
    bell_full = build_bell_section(bell_rows, width)

    if not rows:
        claude_lines = [[("   ", None), ("(inbox empty)", "dim")]]
        claude_actions = [None]
        new_scroll = 0
        avail = 1
    else:
        avail = height - 1 - head_h - len(bell_full)
        if avail < 4:
            avail = min(4, len(rows))
            bl_avail = height - 1 - head_h - avail
            if bl_avail < len(bell_full):
                bl_avail = max(bl_avail, 2)
                hidden = len(bell_full) - (bl_avail - 1)
                bell_full = bell_full[:bl_avail - 1] + [
                    [("   ", None), ("… +%d more (enlarge window)"
                                      % hidden, "dim")]]
        avail = max(avail, 1)
        row_segs, row_actions = render_rows(rows, idx, namecap, metacap,
                                              hdrcap, now)
        pairs = list(zip(row_segs, row_actions))
        new_scroll = follow_cursor(idx, scroll, avail, len(rows))
        view, new_scroll = windowed_rows(
            pairs, new_scroll, avail,
            make_marker=lambda t: (render_marker_segs(t), None))
        claude_lines = [p[0] for p in view]
        claude_actions = [p[1] for p in view]

    lines.extend(claude_lines)
    row_actions_head.extend(claude_actions)
    claude_avail = len(claude_lines)

    lines.extend(bell_full)
    row_actions_head.extend([None] * len(bell_full))

    new_cursor = cursor_id_for_row(rows[idx]) if rows else None

    return {
        "lines": lines,
        "row_actions": row_actions_head,
        "claude_start": claude_start,
        "claude_avail": claude_avail,
        "cursor": new_cursor,
        "scroll": new_scroll,
        "groups": groups,
        "rows": rows,
        "idx": idx,
    }


def apply_wheel(frame, delta):
    """Pure core of a mouse-wheel event: move the Claude section's
    scroll offset by `delta` rows (independent of the cursor), then
    nudge the cursor the minimum distance needed to stay inside the new
    (marker-aware) view. Uses `frame["claude_avail"]` -- the Claude
    section's OWN height -- never a figure that also counts the Bell
    section below it, which would silently cap how far the wheel can
    scroll short of the real last row."""
    rows = frame["rows"]
    total = len(rows)
    avail = frame["claude_avail"]
    new_scroll = scroll_wheel(frame["scroll"], delta, total, avail)
    new_idx = clamp_cursor_to_view(frame["idx"], new_scroll, avail, total)
    new_cursor = cursor_id_for_row(rows[new_idx]) if rows else None
    return new_scroll, new_cursor, new_idx


# ---- curses color pairs --------------------------------------------------

_COLOR_PAIR_SPEC = [
    ("cyan", curses.COLOR_CYAN, False),
    ("cyan_bold", curses.COLOR_CYAN, True),
    ("yellow_bold", curses.COLOR_YELLOW, True),
    ("green_bold", curses.COLOR_GREEN, True),
    ("red_bold", curses.COLOR_RED, True),
    ("magenta_bold", curses.COLOR_MAGENTA, True),
    ("cursor", curses.COLOR_YELLOW, True),
]


def init_colors():
    """Returns {style_name: curses_attr}. Degrades to bold/normal-only
    when the terminal has no color support."""
    attrs = {None: curses.A_NORMAL, "bold": curses.A_BOLD,
             "dim": curses.A_DIM, "qlabel": curses.A_DIM, "empty": curses.A_DIM,
             "low": curses.A_NORMAL, "mid": curses.A_NORMAL,
             "high": curses.A_NORMAL}
    has_color = False
    try:
        has_color = curses.has_colors()
    except curses.error:
        has_color = False
    if has_color:
        try:
            curses.start_color()
            curses.use_default_colors()
        except curses.error:
            has_color = False
    if has_color:
        for i, (name, color, bold) in enumerate(_COLOR_PAIR_SPEC, start=1):
            try:
                curses.init_pair(i, color, -1)
                a = curses.color_pair(i)
                if bold:
                    a |= curses.A_BOLD
                attrs[name] = a
            except curses.error:
                attrs[name] = curses.A_BOLD if bold else curses.A_NORMAL
        attrs["low"] = attrs.get("cyan", curses.A_NORMAL)
        attrs["mid"] = attrs.get("yellow_bold", curses.A_BOLD)
        attrs["high"] = attrs.get("red_bold", curses.A_BOLD)
    else:
        for name, _color, bold in _COLOR_PAIR_SPEC:
            attrs[name] = curses.A_BOLD if bold else curses.A_NORMAL
    return attrs


def draw_frame(win, frame, attrs):
    win.erase()
    h, w = win.getmaxyx()
    for y, segs in enumerate(frame["lines"]):
        if y >= h:
            break
        x = 0
        for text, style in segs:
            if not text or x >= w:
                continue
            avail = w - x
            if disp_width(text) > avail:
                text = clip(text, avail)
            try:
                win.addstr(y, x, text, attrs.get(style, curses.A_NORMAL))
            except curses.error:
                pass
            x += disp_width(text)
    win.refresh()


# ---- main loop ------------------------------------------------------------

def read_entries(state_dir_path):
    entries = []
    for key, raw in list_state_files(state_dir_path):
        e = parse_state_entry(key, raw)
        if e is not None:
            entries.append(e)
    return entries


def read_viewed_ts_map(viewed_dir, entries):
    return {e.key: read_viewed_ts(viewed_dir, e.key) for e in entries}


def gather_refresh(sdir, focus_dir, viewed_dir, age_alert, now, run_query,
                    max_age=0, keep_cap=None, evict=False):
    """All the I/O one full refresh needs, gathered ONCE: tmux queries,
    cleanup_stale eviction (only when `evict` -- ATTN_ONCE never evicts),
    refresh_viewed() (always -- even ATTN_ONCE's one-shot render touches
    .viewed/, matching the bash original, which called refresh_viewed()
    on that path too), then building groups/bells/usage from the
    (post-cleanup) state files. Everything build_frame() needs after
    this is pure data -- no further I/O until the next full refresh."""
    sockets = list_sockets()
    if evict:
        win_keys, answered = list_window_keys(sockets, run_query)
        cleanup_stale(sdir, viewed_dir, win_keys, answered, now, max_age,
                      keep_cap if keep_cap is not None else 10 ** 9)
    refresh_viewed(focus_dir, viewed_dir, sockets, run_query)
    entries = read_entries(sdir)
    viewed_ts_map = read_viewed_ts_map(viewed_dir, entries)
    groups = build_groups(entries, now, viewed_ts_map, age_alert)
    existing_keys = {e.key for e in entries}
    bell_rows = dedupe_bells(list_bell_windows(sockets, run_query),
                              existing_keys)
    usage_cache = read_ratelimit_cache(os.path.join(sdir, ".ratelimit"))
    return groups, bell_rows, usage_cache


def run_once_plain(out=sys.stdout):
    """ATTN_ONCE=1: render a single frame as plain (ANSI, no curses)
    text and exit. Deliberately does NOT evict (evict=False) -- a small
    test terminal must not delete live entries -- but DOES call
    refresh_viewed() via gather_refresh(), same as the bash original."""
    now = int(time.time())
    sdir = state_dir()
    focus_dir = os.path.join(sdir, ".focus")
    viewed_dir = os.path.join(sdir, ".viewed")
    age_alert = int(os.environ.get("ATTN_AGE_ALERT", "300"))
    interval = clamp_interval(sys.argv[1] if len(sys.argv) > 1 else 3.0)
    width = int(os.environ.get("COLUMNS") or shutil.get_terminal_size().columns)
    height = int(os.environ.get("LINES") or shutil.get_terminal_size().lines)

    groups, bell_rows, usage_cache = gather_refresh(
        sdir, focus_dir, viewed_dir, age_alert, now, run_query_default,
        evict=False)

    frame = build_frame(groups, now, False, {}, None, 0, 0, width, height,
                         interval, usage_cache, bell_rows, None)
    for segs in frame["lines"]:
        print(render_ansi(segs), file=out)
    return 0


def main(argv):
    if os.environ.get("ATTN_ONCE") == "1":
        return run_once_plain()

    interval = clamp_interval(argv[1] if len(argv) > 1 else 3.0)
    max_age = int(os.environ.get("ATTN_MAX_AGE", "0"))
    age_alert = int(os.environ.get("ATTN_AGE_ALERT", "300"))
    keep_env = int(os.environ.get("ATTN_KEEP", "0"))
    os.environ.get("ATTN_GRACE", "5")  # accepted, unused (see module docstring)

    sdir = state_dir()
    focus_dir = os.path.join(sdir, ".focus")
    viewed_dir = os.path.join(sdir, ".viewed")
    os.makedirs(sdir, exist_ok=True)
    os.makedirs(focus_dir, exist_ok=True)
    os.makedirs(viewed_dir, exist_ok=True)

    show_all = False
    fold_ovr = {}
    cursor = None
    idx = 0
    scroll = 0
    status_msg = None
    status_expire = 0.0

    def stdscr_main(stdscr):
        nonlocal show_all, fold_ovr, cursor, idx, scroll, status_msg, \
            status_expire
        curses.curs_set(0)
        stdscr.nodelay(False)
        try:
            curses.mousemask(curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED
                              | curses.BUTTON4_PRESSED
                              | getattr(curses, "BUTTON5_PRESSED", 0))
        except curses.error:
            pass
        attrs = init_colors()
        groups = []
        bell_rows = []
        usage_cache = None
        last_full = 0.0

        def do_full_refresh(now):
            nonlocal groups, bell_rows, usage_cache, last_full
            keep_cap = keep_env if keep_env > 0 else stdscr.getmaxyx()[0] * 4
            groups, bell_rows, usage_cache = gather_refresh(
                sdir, focus_dir, viewed_dir, age_alert, now,
                run_query_default, max_age=max_age, keep_cap=keep_cap,
                evict=True)
            last_full = time.monotonic()

        def apply_action(action, frame):
            """Apply one action in place. Returns True when the caller
            should quit. `show_all`/`status_msg`/`status_expire` are the
            outer nonlocals; fold_ovr is mutated directly (it's a dict,
            no nonlocal needed)."""
            nonlocal show_all, status_msg, status_expire
            if action is None:
                return False
            if action["type"] == "quit":
                return True
            if action["type"] == "show_all":
                show_all = not show_all
                fold_ovr.clear()
            elif action["type"] == "toggle":
                for g in frame["groups"]:
                    if g["cpath"] == action["cpath"]:
                        folded_now = resolve_fold(g, show_all, fold_ovr)
                        toggle_group_fold(g, folded_now, fold_ovr)
                        break
            elif action["type"] == "jump":
                entry = _entry_for_key(frame["groups"], action["key"])
                if entry is not None:
                    target = jump_target_for_entry(entry, list_sockets())
                    if target is None:
                        status_msg = "jump failed: socket not found"
                        status_expire = time.monotonic() + 4
                    else:
                        executable = find_jump_executable(
                            os.path.realpath(__file__))
                        if executable is None:
                            status_msg = "jump failed: claude-attn-jump not found"
                            status_expire = time.monotonic() + 4
                        else:
                            curses.def_prog_mode()
                            curses.endwin()
                            rc = run_jump(executable, *target)
                            stdscr.refresh()
                            curses.reset_prog_mode()
                            if rc != 0:
                                status_msg = "jump failed (exit %d)" % rc
                                status_expire = time.monotonic() + 4
            return False

        while True:
            now = int(time.time())
            if status_msg and time.monotonic() >= status_expire:
                status_msg = None
            # Full refresh (tmux queries + refresh_viewed + eviction)
            # once per `interval`; a keypress between ticks only re-lays
            # out the already-gathered groups/bells/usage in build_frame,
            # which does NO I/O at all -- it never re-reads a state file
            # or stats .viewed/ on a keypress.
            if time.monotonic() - last_full >= interval:
                do_full_refresh(now)

            height, width = stdscr.getmaxyx()
            frame = build_frame(groups, now, show_all, fold_ovr, cursor,
                                 idx, scroll, width, height, interval,
                                 usage_cache, bell_rows, status_msg)
            cursor = frame["cursor"]
            idx = frame["idx"]
            scroll = frame["scroll"]
            draw_frame(stdscr, frame, attrs)

            stdscr.timeout(int(interval * 1000))
            ch = stdscr.getch()
            if ch == -1:
                last_full = 0.0  # force a full refresh next loop
                continue

            # Drain the whole burst of already-queued input before the
            # next redraw, so a fast j-j-j-j or a paste costs ONE redraw
            # instead of one per key. "jump" suspends curses for a real
            # subprocess and "quit" exits, so both end the burst instead
            # of being silently batched with view-only toggles.
            quit_now = False
            stdscr.nodelay(True)
            try:
                while ch != -1:
                    action = None
                    if ch == curses.KEY_MOUSE:
                        try:
                            _id, mx, my, _mz, bstate = curses.getmouse()
                        except curses.error:
                            bstate = 0
                            my = -1
                        if bstate & (curses.BUTTON1_CLICKED |
                                     curses.BUTTON1_PRESSED):
                            rel = my - frame["claude_start"]
                            ra = frame["row_actions"][frame["claude_start"]:]
                            action = handle_click(rel, ra)
                        elif bstate & curses.BUTTON4_PRESSED:
                            scroll, cursor, idx = apply_wheel(
                                dict(frame, scroll=scroll, idx=idx), -3)
                        elif bstate & getattr(curses, "BUTTON5_PRESSED", 0):
                            scroll, cursor, idx = apply_wheel(
                                dict(frame, scroll=scroll, idx=idx), 3)
                    else:
                        key = _decode_key(ch, stdscr)
                        rows = frame["rows"]
                        idx, action = handle_key(key, rows, idx)
                        if rows:
                            cursor = cursor_id_for_row(rows[idx])

                    if apply_action(action, frame):
                        quit_now = True
                        break
                    if action is not None and action["type"] == "jump":
                        break
                    ch = stdscr.getch()
            finally:
                stdscr.nodelay(False)
            if quit_now:
                return

    def _entry_for_key(groups, key):
        for g in groups:
            for e, _cls in g["entries"]:
                if e.key == key:
                    return e
        return None

    def _decode_key(ch, stdscr):
        if ch in (curses.KEY_ENTER, 10, 13):
            return "ENTER"
        if ch == curses.KEY_UP:
            return "UP"
        if ch == curses.KEY_DOWN:
            return "DOWN"
        if ch == curses.KEY_RESIZE:
            return ""
        try:
            return chr(ch)
        except (ValueError, OverflowError):
            return ""

    curses.wrapper(stdscr_main)
    return 0


def run_query_default(argv):
    return subprocess.run(argv, capture_output=True, text=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv) or 0)
