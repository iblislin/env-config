#!/usr/bin/env bash
# claude-attn-board [interval]
#
# Single-pane dashboard that collects, across ALL local tmux
# sockets/servers (/tmp/tmux-1000-inner*), two kinds of "attention"
# signals and refreshes them in place, flicker-free and size-aware:
#
#   1. Claude - from ~/.claude/tmux-status/ (written by claude-attn-hook):
#               which window's Claude finished (DONE) or is waiting (WAIT),
#               labeled by the session's /rename title (else ai-title).
#               The hook rings that window's bell; an entry clears only
#               after the bell went 1 -> 0, i.e. you actually SELECTED the
#               window. Entries never expire by time (unless ATTN_MAX_AGE).
#   2. Bell   - any OTHER tmux window whose bell flag is set (the '!' in the
#               title) -- covers every program. Windows already shown in the
#               Claude section are not repeated here.
#
# Rendering: uses the alternate screen buffer and redraws in place with
# per-line erase-to-EOL, so nothing blinks. Every row is clipped to the
# current terminal width; the list is capped to its height with a
# "+N more" footer. Both are re-measured each frame (resize-aware).
#
# Usage: claude-attn-board [refresh_seconds]   (default 3)
#
# Env:
#   ATTN_GRACE      grace after the event before a bell-cleared entry may
#                   be dropped (covers the write race), seconds  (default 5)
#   ATTN_MAX_AGE    hard time expiry, seconds; 0 = never expire  (default 0)
#   ATTN_AGE_ALERT  unread entries older than this get an urgent (red)
#                   dot instead of the normal one, seconds       (default 300)
#   ATTN_KEEP       max Claude entries to retain as history; 0 = 4x the
#                   terminal height                              (default 0)
#   ATTN_ONCE=1     render one frame to stdout and exit (testing; no eviction)
#
# Inbox model: entries persist as read/unread history, like a mail inbox.
#   * unread  = you have not had WM focus on that window since the event
#               (claude-attn-focus hooks): shown bold with a bright dot.
#   * read    = you looked at it after the event: kept, shown dimmed.
# Newest event floats to the top; a status change re-stamps the entry so its
# window jumps back to the top. History is capped to ATTN_KEEP; the oldest
# entries beyond the cap are evicted.
#
# Threads: entries are GROUPED BY PROJECT (the pane's cwd), like mail
# threads -- one header row per project, its windows indented beneath.
# Groups order by their newest event. A group with nothing unread and
# nothing running is folded to its header (▸); others are open (▾).
# Keys:  j/k or arrows  move the cursor (>) between groups
#        Enter / space  toggle the fold of the cursor group (sticks until a
#                       newer event lands in that group, then auto-reopens)
#        a              show all entries (ignore auto-fold), toggle
#        g / G          first / last group        q  quit
# ---- Why this is still bash, and when to stop (verdict of 2026-09-02) ----
# Checked before adding the fold tree + keys: no fzf/gum on this box, dialog
# cannot do a live list, textual/rich only exist as an old pip copy. Python's
# stdlib curses is the right target -- getch+timeout replaces read -rsn1,
# KEY_RESIZE/KEY_UP replace hand-parsed escapes, it diffs the redraw itself,
# and clipping can use unicodedata.east_asian_width instead of the hand-
# budgeted "W - namecap - 22" below. claude-attn-title is already Python, so
# the tool would become one language. The two slowest bugs this round were
# bash-specific (a subshell losing the group arrays; GROUPS being a builtin).
#
# Not ported yet because it works and is tested. PORT AT THE NEXT FEATURE that
# needs a per-ROW cursor (Enter -> jump to that tmux window, search/filter,
# mouse): the key/scroll logic would double again in bash. What the port
# throws away: the ~250 lines of terminal layer here (clip, draw, read_key,
# scroll, measure). What it keeps: every state file, the hook, the focus
# tracker, the title cache -- the data model does not change.
#
# Dependencies for that port: the user is fine with any Python package in a
# venv. Put one under ~/venv/ (they are cheap) and point the shebang at its
# interpreter, e.g. #!/home/iblis/venv/attn/bin/python3 -- do NOT depend on
# ~/venv/py3, which is a working venv for other projects. Prefer stdlib curses
# unless a package removes real code.
set -u

INTERVAL="${1:-3}"
MAX_AGE="${ATTN_MAX_AGE:-0}"
AGE_ALERT="${ATTN_AGE_ALERT:-300}"
KEEP="${ATTN_KEEP:-0}"
STATE_DIR="$HOME/.claude/tmux-status"
mkdir -p "$STATE_DIR"

sockets() { printf '%s\n' /tmp/tmux-1000-inner /tmp/tmux-1000-inner-*; }
safe() { printf '%s' "$1" | tr '/ \t' '___'; }

# Shorten $HOME prefix to ~ for display.
tilde() {
  case "$1" in
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    "$HOME")   printf '~' ;;
    *)         printf '%s' "$1" ;;
  esac
}

# Clip a string to N display columns (approx; counts code points), adding
# an ellipsis when truncated.
clip() {
  local s="$1" n="$2"
  [ "$n" -lt 1 ] && { printf ''; return; }
  if [ "${#s}" -le "$n" ]; then printf '%s' "$s"
  else printf '%s…' "${s:0:n-1}"; fi
}

FOCUS_DIR="$STATE_DIR/.focus"     # focused client ttys (set by claude-attn-focus hook)
VIEWED_DIR="$STATE_DIR/.viewed"   # per-window last-actually-viewed time (file mtime)
mkdir -p "$FOCUS_DIR" "$VIEWED_DIR" 2>/dev/null

# All existing window keys (reliable), for detecting closed windows.
declare -A WIN_EXISTS=()
refresh_windows() {
  WIN_EXISTS=()
  local s sn key
  for s in $(sockets); do
    [ -S "$s" ] || continue
    sn="$(basename "$s")"
    while IFS= read -r key; do
      [ -n "$key" ] && WIN_EXISTS["$key"]=1
    done < <(tmux -S "$s" list-windows -a -F "${sn}__#{session_name}__#{window_index}" 2>/dev/null)
  done
}

# The window you're ACTUALLY looking at = the current window of every tmux
# client that has WM focus right now. Focus comes from the client-focus-in/out
# hooks (accurate; the pollable client_flags 'focused' token gets stuck), and
# which window that client is on is queried live. Stamps each viewed window's
# last-viewed time (VIEWED_DIR mtime) -> that's what marks an entry "read".
declare -A VIEWED=()
refresh_viewed() {
  VIEWED=()
  local s sn tty f key
  declare -A TTY_SOCK=()
  for s in $(sockets); do
    [ -S "$s" ] || continue
    while IFS= read -r tty; do
      [ -n "$tty" ] && TTY_SOCK["$tty"]="$s"
    done < <(tmux -S "$s" list-clients -F '#{client_tty}' 2>/dev/null)
  done
  shopt -s nullglob
  for f in "$FOCUS_DIR"/*; do
    tty="$(cat "$f" 2>/dev/null)"
    s="${TTY_SOCK[$tty]:-}"
    [ -n "$tty" ] && [ -n "$s" ] || { rm -f "$f"; continue; }   # focused client gone -> prune
    sn="$(basename "$s")"
    key="$(tmux -S "$s" display-message -p -c "$tty" -F "${sn}__#{session_name}__#{window_index}" 2>/dev/null)"
    [ -n "$key" ] && VIEWED["$key"]=1
  done
  for key in "${!VIEWED[@]}"; do touch "$VIEWED_DIR/$key" 2>/dev/null; done
}

# Inbox upkeep. Entries are NOT dropped on read -- they persist as history.
# We only evict: (a) entries whose tmux window no longer exists, (b) entries
# past MAX_AGE when configured, and (c) the oldest entries beyond the history
# cap (ATTN_KEEP, or the terminal height passed in as $1).
cleanup_stale() {
  local cap="${1:-40}"
  refresh_windows
  refresh_viewed
  local now f base ts
  now="$(date +%s)"
  shopt -s nullglob
  # Pass 1: drop dead windows / expired entries.
  for f in "$STATE_DIR"/*; do
    base="$(basename "$f")"
    ts="$(cut -f1 "$f" 2>/dev/null)"
    [ -n "$ts" ] || { rm -f "$f"; continue; }
    if [ "$MAX_AGE" -gt 0 ] && [ $(( now - ts )) -ge "$MAX_AGE" ]; then
      rm -f "$f"; continue
    fi
    [ -z "${WIN_EXISTS[$base]:-}" ] && rm -f "$f"       # window gone
  done
  # Pass 2: evict the oldest entries beyond the history cap.
  [ "$cap" -lt 1 ] && cap=1
  local rank=0
  for f in "$STATE_DIR"/*; do
    printf '%s\t%s\n' "$(cut -f1 "$f" 2>/dev/null)" "$f"
  done | sort -rn | while IFS=$'\t' read -r _ts f; do
    rank=$(( rank + 1 ))
    [ "$rank" -gt "$cap" ] && rm -f "$f"
  done
  # Pass 3: prune orphan last-viewed stamps (no matching inbox entry).
  for f in "$VIEWED_DIR"/*; do
    [ -e "$STATE_DIR/$(basename "$f")" ] || rm -f "$f"
  done
}

# Human-readable age: 42s / 5m / 3h / 2d
fmt_age() {
  local a="$1"
  if   [ "$a" -lt 60 ]    ; then printf '%ds' "$a"
  elif [ "$a" -lt 3600 ]  ; then printf '%dm' $(( a / 60 ))
  elif [ "$a" -lt 86400 ] ; then printf '%dh' $(( a / 3600 ))
  else                           printf '%dd' $(( a / 86400 )); fi
}

# ---- usage gauge (mirrors the /statusline build_mini style) ----------
# 256-color palette, identical to statusline-command.sh.
U_RESET=$'\033[0m'; U_DIM=$'\033[2m'
U_LOW=$'\033[38;5;114m'; U_MID=$'\033[38;5;221m'; U_HIGH=$'\033[38;5;203m'
U_EMPTY=$'\033[38;5;238m'; U_QLABEL=$'\033[38;5;245m'

# Countdown to a future unix ts: 2h14m / 45m / 3d4h (empty if past/invalid).
fmt_countdown() {
  local target="${1%.*}" now diff d h m
  case "$target" in ''|*[!0-9]*) return ;; esac
  now="$(date +%s)"; diff=$(( target - now )); [ "$diff" -le 0 ] && return
  d=$(( diff / 86400 )); h=$(( (diff % 86400) / 3600 )); m=$(( (diff % 3600) / 60 ))
  if   [ "$d" -gt 0 ]; then printf '%dd%dh' "$d" "$h"
  elif [ "$h" -gt 0 ]; then printf '%dh%02dm' "$h" "$m"
  else [ "$m" -lt 1 ] && m=1; printf '%dm' "$m"; fi
}

# Build one 10-cell quota gauge -> sets M_PLAIN (length math) + M_COLORED.
mini() {
  local label="$1" pct="$2" reset="$3" filled empty c fstr="" estr="" i=0 cd rp="" rc=""
  filled=$(( pct / 10 )); [ "$filled" -gt 10 ] && filled=10; [ "$filled" -lt 0 ] && filled=0
  empty=$(( 10 - filled ))
  if   [ "$pct" -lt 50 ]; then c=$U_LOW
  elif [ "$pct" -lt 80 ]; then c=$U_MID
  else c=$U_HIGH; fi
  while [ "$i" -lt "$filled" ]; do fstr="${fstr}█"; i=$(( i + 1 )); done
  i=0; while [ "$i" -lt "$empty" ]; do estr="${estr}░"; i=$(( i + 1 )); done
  cd="$(fmt_countdown "$reset")"
  [ -n "$cd" ] && { rp=" ↻$cd"; rc=" ${c}↻${cd}${U_RESET}"; }
  M_PLAIN="$(printf '%s: [%s%s] %d%%%s' "$label" "$fstr" "$estr" "$pct" "$rp")"
  M_COLORED="${U_QLABEL}${label}:${U_RESET} ${U_DIM}[${U_RESET}${c}${fstr}${U_EMPTY}${estr}${U_RESET}${U_DIM}]${U_RESET} ${c}${pct}%${U_RESET}${rc}"
}

# Emit the usage line from the statusline-written cache (nothing if absent).
render_usage() {
  local W="$1" cache="$STATE_DIR/.ratelimit" upd fp fr wp wr now age
  [ -f "$cache" ] || return
  IFS=$'\t' read -r upd fp fr wp wr < "$cache" 2>/dev/null
  fp="${fp%.*}"; wp="${wp%.*}"
  case "$fp" in ''|*[!0-9]*) fp="" ;; esac
  case "$wp" in ''|*[!0-9]*) wp="" ;; esac
  [ -n "$fp$wp" ] || return
  now="$(date +%s)"; age=$(( now - ${upd:-now} ))
  local plain="" colored=""
  if [ -n "$fp" ]; then mini "5h" "$fp" "$fr"; plain="$M_PLAIN"; colored="$M_COLORED"; fi
  if [ -n "$wp" ]; then
    mini "7d" "$wp" "$wr"
    [ -n "$plain" ] && { plain="$plain  $M_PLAIN"; colored="$colored  $M_COLORED"; } \
                    || { plain="$M_PLAIN"; colored="$M_COLORED"; }
  fi
  local stale=""
  [ "$age" -ge 120 ] && stale="  ${U_DIM}⟳$(fmt_age "$age") ago${U_RESET}"
  local stale_plain=""; [ -n "$stale" ] && stale_plain="  ⟳$(fmt_age "$age") ago"
  # Fit to width: full gauge if it fits, else a compact "5h 63% 7d 28%".
  if [ "$(( ${#plain} + ${#stale_plain} ))" -le "$W" ]; then
    printf ' %s%s\n' "$colored" "$stale"
  else
    local comp="" compp=""
    [ -n "$fp" ] && { comp="${U_QLABEL}5h${U_RESET} ${fp}%"; compp="5h ${fp}%"; }
    [ -n "$wp" ] && { comp="$comp  ${U_QLABEL}7d${U_RESET} ${wp}%"; compp="$compp  7d ${wp}%"; }
    if [ "${#compp}" -le "$W" ]; then printf ' %s\n' "$comp"
    else printf ' %s\n' "$(clip "$compp" "$W")"; fi
  fi
}

# ---- Claude section: inbox grouped by project (pane cwd), like mail threads.
# Each project is a "thread" (header row), each window an entry under it.
# Groups are ordered by their newest event; entries inside by ts desc.
# A group is FOLDED (header only) by default when it holds no unread and no
# running entry -- all-read history stays reachable but out of the way.
# Enter/space on the cursor group toggles the fold; the manual state is
# remembered until a NEWER event lands in that group (then it auto-reopens,
# consistent with "a status change re-floats the window").
#
# Output goes to globals (not stdout) because the main loop needs the
# group list back and a pipeline/subshell would lose it:
#   CL[]        rendered lines of the section
#   G_PATHS[]    cpath per group, in display order (cursor indexes this)
#   G_NEWEST[]  newest event ts per group (for the fold-override expiry)
#   G_FOLDED[]  effective fold state per group (1 folded / 0 open)
#   HDR_LINE[]  index into CL of each group's header row (for scrolling)
# (Not named GROUPS: that is a bash builtin -- the user's gid list -- and
# assignments to it are silently ignored, so the cursor indexed gids.)
declare -a CL=() G_PATHS=() G_NEWEST=() G_FOLDED=() HDR_LINE=()
declare -A FOLD_OVR=()   # cpath -> "<newest_ts_at_toggle>:<0|1>"
CUR=0                    # cursor = index into G_PATHS
SHOW_ALL=0               # 1 = ignore auto-fold (show every entry)

render_claude() {
  local W="$1" now key ts st winid wname sockname cpath label age viewed_ts f e
  local name meta namecap metacap dot icon icon_col row
  CL=(); G_PATHS=(); G_NEWEST=(); G_FOLDED=(); HDR_LINE=()
  now="$(date +%s)"
  shopt -s nullglob
  local files=("$STATE_DIR"/*)
  if [ ${#files[@]} -eq 0 ]; then
    CL+=("$(printf '   \033[2m(inbox empty)\033[0m')"); return
  fi
  # key<TAB>state-line per entry, sorted by ts desc (field 2).
  local -a entries=()
  for f in "${files[@]}"; do entries+=("$(basename "$f")	$(cat "$f")"); done
  mapfile -t entries < <(printf '%s\n' "${entries[@]}" | sort -t$'\t' -k2,2rn)

  # Row geometry. Rows are indented 2 under their header, so the non-name
  # overhead is 22: indent (2), dot+sp (2), icon (7 -- ✅/⏳ are 2 cols
  # wide), 2 spaces, name, space, age (5), 2 spaces, +1 slack.
  namecap=30; [ "$namecap" -gt $(( W / 3 )) ] && namecap=$(( W / 3 ))
  [ "$namecap" -lt 8 ] && namecap=8
  metacap=$(( W - namecap - 22 ))

  local -A g_rows=() g_unread=() g_read=() g_run=() g_newest=()
  local -a g_order=()
  for e in "${entries[@]}"; do
    IFS=$'\t' read -r key ts st winid wname sockname cpath label <<<"$e"
    [ -n "$ts" ] || continue
    age=$(( now - ts ))
    if [ -z "${g_newest[$cpath]:-}" ]; then
      g_order+=("$cpath"); g_newest[$cpath]="$ts"
      g_unread[$cpath]=0; g_read[$cpath]=0; g_run[$cpath]=0; g_rows[$cpath]=""
    fi
    # read = you actually looked at this window (had WM focus on it) AFTER the
    # event; unread otherwise. Focus-based, independent of the tmux bell.
    viewed_ts="$(stat -c%Y "$VIEWED_DIR/$key" 2>/dev/null || echo 0)"
    [ -n "$label" ] && name="$label" || name="$wname"
    name="$(clip "$name" "$namecap")"
    [ "$metacap" -ge 8 ] && meta="$(clip "[$winid]" "$metacap")" || meta=""
    case "$st" in
      running) icon='▶ RUN  '; icon_col='\033[36m' ;;   # padded to 7 cols to align with emoji icons
      waiting) icon='⏳ WAIT'; icon_col='\033[1;33m' ;;
      done)    icon='✅ DONE'; icon_col='\033[1;32m' ;;
      *)       icon="$st";     icon_col='' ;;
    esac
    if [ "$st" = "running" ]; then
      # ACTIVE: Claude is working -- neutral cyan, no read/unread dimming.
      row="$(printf '\033[36m▸\033[0m %b%s\033[0m  %-*s %5s  \033[2m%s\033[0m' \
        "$icon_col" "$icon" "$namecap" "$name" "$(fmt_age "$age")" "$meta")"
      g_run[$cpath]=$(( g_run[$cpath] + 1 ))
    elif [ "$viewed_ts" -lt "$ts" ]; then
      # UNREAD: not viewed since the event. Bold, bright dot (red if long).
      [ "$age" -ge "$AGE_ALERT" ] && dot='\033[1;31m●\033[0m' || dot='\033[1;36m●\033[0m'
      row="$(printf '%b %b%b\033[0m  \033[1m%-*s\033[0m %5s  \033[2m%s\033[0m' \
        "$dot" "$icon_col" "$icon" "$namecap" "$name" "$(fmt_age "$age")" "$meta")"
      g_unread[$cpath]=$(( g_unread[$cpath] + 1 ))
    else
      # READ: fully dimmed history, hollow dot.
      row="$(printf '\033[2m○ %s  %-*s %5s  %s\033[0m' \
        "$icon" "$namecap" "$name" "$(fmt_age "$age")" "$meta")"
      g_read[$cpath]=$(( g_read[$cpath] + 1 ))
    fi
    g_rows[$cpath]+="  ${row}"$'\n'
  done

  # Emit groups. Header: "<cursor><fold> <~cpath>  ●N ○N ▶N  age".
  local n=${#g_order[@]} i=0 cp folded ovr hdr hdrcap cur fold_glyph cnt cnt_plain
  [ "$CUR" -ge "$n" ] && CUR=$(( n - 1 )); [ "$CUR" -lt 0 ] && CUR=0
  # Header overhead: cursor+fold+sp (3), 2 sp, counts (~14), 2 sp, age (5).
  hdrcap=$(( W - 26 )); [ "$hdrcap" -lt 8 ] && hdrcap=8
  for cp in "${g_order[@]}"; do
    folded=1
    { [ "${g_unread[$cp]}" -gt 0 ] || [ "${g_run[$cp]}" -gt 0 ]; } && folded=0
    [ "$SHOW_ALL" = 1 ] && folded=0
    ovr="${FOLD_OVR[$cp]:-}"
    if [ -n "$ovr" ]; then
      # Manual toggle sticks until a newer event lands in the group.
      if [ "${ovr%%:*}" -ge "${g_newest[$cp]}" ]; then folded="${ovr##*:}"
      else unset "FOLD_OVR[$cp]"; fi
    fi
    G_PATHS+=("$cp"); G_NEWEST+=("${g_newest[$cp]}"); G_FOLDED+=("$folded")
    [ "$i" -eq "$CUR" ] && cur=$'\033[1;33m>\033[0m' || cur=' '
    [ "$folded" = 1 ] && fold_glyph='▸' || fold_glyph='▾'
    cnt=""
    [ "${g_unread[$cp]}" -gt 0 ] && cnt+="$(printf '\033[1;36m●%-2d\033[0m ' "${g_unread[$cp]}")" || cnt+="    "
    [ "${g_run[$cp]}"    -gt 0 ] && cnt+="$(printf '\033[36m▶%-2d\033[0m '   "${g_run[$cp]}")"    || cnt+="    "
    cnt+="$(printf '\033[2m○%-2d\033[0m' "${g_read[$cp]}")"
    hdr="$(printf '%s%s \033[1m%-*s\033[0m  %s  %5s' \
      "$cur" "$fold_glyph" "$hdrcap" "$(clip "$(tilde "$cp")" "$hdrcap")" \
      "$cnt" "$(fmt_age $(( now - g_newest[$cp] )))")"
    HDR_LINE+=("${#CL[@]}"); CL+=("$hdr")
    if [ "$folded" != 1 ]; then
      while IFS= read -r row; do [ -n "$row" ] && CL+=("$row"); done <<<"${g_rows[$cp]}"
    fi
    i=$(( i + 1 ))
  done
}

# Emit Bell rows (already clipped to $W), skipping windows already in the
# Claude section (dedupe).
render_bells() {
  local W="$1" s sn sess win wname key any=0 line
  shopt -s nullglob
  for s in $(sockets); do
    [ -S "$s" ] || continue
    sn="$(basename "$s")"
    while IFS=$'\t' read -r sess win wname; do
      key="$(safe "$sn")__$(safe "$sess")__$(safe "$win")"
      [ -e "$STATE_DIR/$key" ] && continue
      any=1
      line="$(clip "$sess:$win $wname  [$sn]" $(( W - 6 )))"
      printf '   \033[1;31m🔔\033[0m  %s\n' "$line"
    done < <(tmux -S "$s" list-windows -a -f '#{window_bell_flag}' \
               -F '#{session_name}	#{window_index}	#{window_name}' 2>/dev/null)
  done
  [ "$any" -eq 0 ] && printf '   \033[2m(none)\033[0m\n'
}

# Build the whole frame into OUT[] (globals; see render_claude for why).
# Layout: head (title, usage, rule, "Claude" heading) / Claude section, which
# scrolls so the cursor group stays visible / Bell section at the bottom.
declare -a OUT=()
SCROLL=0
render_frame() {
  local W="$1" H="$2" tmp
  OUT=()
  # Title: drop the key hint when it does not fit (clip cannot see ESC bytes).
  local hint="(every ${INTERVAL}s · j/k move · Enter fold · a all · q quit)" ts
  ts="$(date '+%H:%M:%S')"
  [ $(( 23 + ${#ts} + 2 + ${#hint} )) -gt "$W" ] && hint="(every ${INTERVAL}s)"
  OUT+=("$(printf '\033[1m tmux attention board \033[0m%s  \033[2m%s\033[0m' "$ts" "$hint")")
  mapfile -t tmp < <(render_usage "$W"); OUT+=("${tmp[@]}")
  OUT+=("$(clip ' ─────────────────────────────────────────────────────────────────────' "$W")")
  OUT+=("$(printf '\033[1;36m Claude\033[0m  \033[2m(grouped by project cwd)\033[0m')")
  render_claude "$W"
  local -a BL=("$(printf '\033[1;35m Bell (other windows)\033[0m')")
  mapfile -t tmp < <(render_bells "$W"); BL+=("${tmp[@]}")

  # Height budget: bells keep their lines unless that would starve the
  # Claude section below 4 lines; then bells get "+N more" instead.
  local avail total cur_line hidden_below
  avail=$(( H - 1 - ${#OUT[@]} - ${#BL[@]} ))
  if [ "$avail" -lt 4 ]; then
    avail=4; [ "$avail" -gt "${#CL[@]}" ] && avail="${#CL[@]}"
    local bl_avail=$(( H - 1 - ${#OUT[@]} - avail ))
    if [ "$bl_avail" -lt "${#BL[@]}" ]; then
      [ "$bl_avail" -lt 2 ] && bl_avail=2
      hidden_below=$(( ${#BL[@]} - (bl_avail - 1) ))
      BL=( "${BL[@]:0:bl_avail-1}" "$(printf '\033[2m   … +%d more (enlarge window)\033[0m' "$hidden_below")" )
    fi
  fi
  # Scroll the Claude section so the cursor's header row is visible, keeping
  # the first/last visible line free for the ↑/↓ "more" markers when needed.
  total="${#CL[@]}"
  if [ "$total" -le "$avail" ]; then
    SCROLL=0
    OUT+=("${CL[@]}")
  else
    cur_line="${HDR_LINE[$CUR]:-0}"
    [ "$cur_line" -lt $(( SCROLL + 1 )) ] && SCROLL=$(( cur_line - 1 ))
    [ "$cur_line" -gt $(( SCROLL + avail - 2 )) ] && SCROLL=$(( cur_line - avail + 2 ))
    [ "$SCROLL" -gt $(( total - avail )) ] && SCROLL=$(( total - avail ))
    [ "$SCROLL" -lt 0 ] && SCROLL=0
    local -a view=("${CL[@]:SCROLL:avail}")
    hidden_below=$(( total - SCROLL - avail ))
    [ "$SCROLL" -gt 0 ] && view[0]="$(printf '\033[2m   ↑ %d more\033[0m' "$SCROLL")"
    [ "$hidden_below" -gt 0 ] && view[avail-1]="$(printf '\033[2m   ↓ %d more\033[0m' "$hidden_below")"
    OUT+=("${view[@]}")
  fi
  OUT+=("${BL[@]}")
}

draw() {
  printf '\033[H'
  local ln; for ln in "${OUT[@]}"; do printf '%s\033[K\n' "$ln"; done
  printf '\033[J'
}

# One keypress (or the refresh interval elapsing). Sets KEY to one of:
# TIMEOUT, ENTER, UP, DOWN, or the literal character.
read_key() {
  local k k2 k3 rc
  IFS= read -rsn1 -t "${1:-$INTERVAL}" k; rc=$?
  if [ "$rc" -gt 128 ]; then KEY=TIMEOUT; return; fi
  [ "$rc" -ne 0 ] && { KEY=TIMEOUT; return; }
  case "$k" in
    ''|$'\r'|$'\n')  KEY=ENTER ;;   # '' = newline consumed as delimiter; raw ttys send \r
    $'\033')
      KEY=ESC
      if IFS= read -rsn1 -t 0.05 k2 && IFS= read -rsn1 -t 0.05 k3; then
        case "$k2$k3" in '[A') KEY=UP ;; '[B') KEY=DOWN ;; esac
      fi ;;
    *)   KEY="$k" ;;
  esac
}

toggle_fold() {
  local cp="${G_PATHS[$CUR]:-}" cur
  [ -n "$cp" ] || return
  # Current state = a pending override from this same key burst if any (the
  # frame has not been redrawn yet), else what the last frame showed.
  cur="${G_FOLDED[$CUR]}"
  [ -n "${FOLD_OVR[$cp]:-}" ] && cur="${FOLD_OVR[$cp]##*:}"
  FOLD_OVR[$cp]="${G_NEWEST[$CUR]}:$(( 1 - cur ))"
}

measure() {
  W="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
  H="${LINES:-$(tput lines 2>/dev/null || echo 24)}"
  # History cap: ATTN_KEEP if set (>0), else 4x the terminal height. (Was 1x
  # when every entry cost a line; folded groups now hide most read history,
  # so the screen holds far more entries than it has lines.)
  keep_cap="$KEEP"; [ "$keep_cap" -lt 1 ] 2>/dev/null && keep_cap=$(( H * 4 ))
}

# ATTN_ONCE=1: render a single frame to stdout and exit (testing / piping).
# Deliberately does NOT evict history -- a small test terminal must not
# delete live entries.
if [ "${ATTN_ONCE:-0}" = 1 ]; then
  measure; refresh_windows; refresh_viewed; render_frame "$W" "$H"
  printf '%s\n' "${OUT[@]}"; exit 0
fi

cleanup() { printf '\033[?25h\033[?1049l'; exit 0; }
trap cleanup INT TERM
printf '\033[?1049h\033[?25l'   # alt screen + hide cursor

INTERACTIVE=0; [ -t 0 ] && INTERACTIVE=1
while :; do
  measure
  cleanup_stale "$keep_cap"
  render_frame "$W" "$H"
  draw
  if [ "$INTERACTIVE" = 1 ]; then
    # Wait for a key (or the interval), then drain any keys already queued
    # so a burst like "jjj" costs one redraw, not three (a frame is ~0.5s).
    read_key
    while [ "$KEY" != TIMEOUT ]; do
      case "$KEY" in
        j|DOWN) CUR=$(( CUR + 1 )) ;;
        k|UP)   CUR=$(( CUR - 1 )) ;;
        g)      CUR=0 ;;
        G)      CUR=$(( ${#G_PATHS[@]} - 1 )) ;;
        ENTER|' '|o) toggle_fold ;;
        a)      SHOW_ALL=$(( 1 - SHOW_ALL )); FOLD_OVR=() ;;
        q)      cleanup ;;
      esac
      [ "$CUR" -lt 0 ] && CUR=0
      [ "$CUR" -ge "${#G_PATHS[@]}" ] && CUR=$(( ${#G_PATHS[@]} - 1 ))
      [ "$CUR" -lt 0 ] && CUR=0
      read_key 0.02
    done
  else
    sleep "$INTERVAL"
  fi
done
