    """"""""""""""""""""""""""""""""""""""""
    " Fern
    """"""""""""""""""""""""""""""""""""""""
    " How to use?
    "
    " <CR>    Open selected file, or enter selected dir
    " e       Open selected file in the previous window
    " l       Open selected file, or expand selected dir
    " h       Collapse the current node
    " t       Open selected node in a new tab
    " s       Open selected file in a split window
    " E       Open selected file in a side split window
    " i       Reveal the file of the current buffer in the tree
    " !       Toggle hidden files
    " -       Mark / unmark the selected node
    " N / K   Create a new file / dir
    " c / m   Copy / move the selected node
    " D       Trash the selected node
    " <F5>    Reload the whole tree
    " <leader>n again closes the drawer
    let g:fern#drawer_width = 22
    " One drawer for the whole vim instance instead of one per tabpage, so the
    " expanded state is shared across tabs -- the NERDTreeMirror equivalent.
    " fern supports this explicitly: viewer/auto_duplication.vim opts out of its
    " "only one window per fern buffer" rule for exactly this combination.
    let g:fern#disable_drawer_tabpage_isolation = 1
    " g:fern#default_exclude is a single pattern matched against the node label
    let s:fern_exclude = ['\~$']  " vim temp files
    let s:fern_exclude += ['\.pyc$', '\.pyo$', '^__pycache__$']  " python
    let s:fern_exclude += ['\.beam$']  " erlang
    let s:fern_exclude += ['\.a$', '\.so$', '\.o$']  " some native stuff
    let s:fern_exclude += ['^cscope\.out$']
    let g:fern#default_exclude = join(s:fern_exclude, '\|')
    let g:fern#renderer#default#collapsed_symbol = "|+ "
    let g:fern#renderer#default#expanded_symbol = "|~ "
    nnoremap <leader>n :Fern . -drawer -toggle<CR>

    " NERDTree muscle memory.  Mostly fern's own wiki, "Define NERDTree like
    " mappings"; three <Plug> names there are stale as of fern 3bbca3c and are
    " corrected here -- `fern-action-hidden:toggle` (not `-toggle`) and the
    " `action-` prefix on `open-or-expand`.  A nmap to a <Plug> that does not
    " exist raises no error, the key just silently does nothing.
    function! s:init_fern() abort
        " The whole point: in NERDTree <CR> and o TOGGLE a dir -- expand when
        " collapsed, fold it back when already expanded (nerdtree's
        " tree_dir_node.vim activate() calls toggleOpen()) -- and they NEVER
        " change the root.  fern's default <CR> is open-or-enter, which does
        " change it, and that is also what desynchronises the drawer between
        " tabs since the root is part of the drawer's buffer name.
        "
        " fern registers no toggle action for branches, only expand and
        " collapse, so the choice is made per node status.  fern#smart#leaf
        " dispatches on STATUS_NONE / STATUS_COLLAPSED / STATUS_EXPANDED; the
        " wiki's version of this passes collapse for the leaf slot, which would
        " fold the parent instead of opening the file under the cursor.
        nmap <buffer><expr> <Plug>(fern-my-nerdtree-activate)
                    \ fern#smart#leaf(
                    \   "\<Plug>(fern-action-open:edit)",
                    \   "\<Plug>(fern-action-expand:stay)",
                    \   "\<Plug>(fern-action-collapse)",
                    \ )
        nmap <buffer><nowait> <CR> <Plug>(fern-my-nerdtree-activate)
        nmap <buffer><nowait> o    <Plug>(fern-my-nerdtree-activate)
        nmap <buffer> go <Plug>(fern-action-open:edit)<C-w>p
        nmap <buffer> t  <Plug>(fern-action-open:tabedit)
        nmap <buffer> T  <Plug>(fern-action-open:tabedit)gT
        " NERDTree's i/s are splits, so reveal loses its default `i` slot.
        nmap <buffer> i  <Plug>(fern-action-open:split)
        nmap <buffer> gi <Plug>(fern-action-open:split)<C-w>p
        nmap <buffer> s  <Plug>(fern-action-open:vsplit)
        nmap <buffer> gs <Plug>(fern-action-open:vsplit)<C-w>p
        " :stay, not the default :in alias -- NERDTree's O leaves the cursor on
        " the node, and a cursor that walks into the tree breaks the <CR> toggle
        " above by pointing it at a different node on the second press.
        nmap <buffer> O  <Plug>(fern-action-expand-tree:stay)
        " Not exact: NERDTree's x closes the node's PARENT, fern collapses the
        " node itself.
        nmap <buffer> x  <Plug>(fern-action-collapse)
        " Root movement keeps NERDTree's own keys instead of riding on <CR>.
        nmap <buffer> C  <Plug>(fern-action-enter)
        nmap <buffer> u  <Plug>(fern-action-leave)
        nmap <buffer> ma <Plug>(fern-action-new-path)
        nmap <buffer> P  gg
        nmap <buffer> r  <Plug>(fern-action-reload)
        nmap <buffer> R  gg<Plug>(fern-action-reload)<C-o>
        nmap <buffer> cd <Plug>(fern-action-cd)
        nmap <buffer> CD gg<Plug>(fern-action-cd)<C-o>
        nmap <buffer> I  <Plug>(fern-action-hidden:toggle)
        nmap <buffer> q  :<C-u>quit<CR>
    endfunction

    augroup fern_nerdtree_keys
        autocmd!
        autocmd FileType fern call s:init_fern()
    augroup END

    " Colours.  NERDTree hardcoded none of its own: every one of its groups is a
    " `hi def link` into a colourscheme group (nerdtree syntax/nerdtree.vim:63-95),
    " so its colours came from `iblis`, and mimicking it means relinking fern's
    " groups to the same targets rather than naming a colour here.  fern is built
    " the same way and documents `User FernHighlight` for exactly this.
    "
    " Identical by default and deliberately left alone: the dir name and its +/~
    " marker (NERDTreeDir / NERDTreeOpenable / NERDTreeClosable -> Directory vs
    " fern FernBranchText / FernBranchSymbol -> Directory) and the file name
    " (NERDTreeFile resolves to `cleared`, fern FernLeafText -> NONE).
    function! s:fern_nerdtree_highlight() abort
        " NERDTreeCWD -> Statement; fern defaults its root to Directory.
        highlight link FernRootSymbol Statement
        highlight link FernRootText   Statement
        " NERDTreeDirSlash -> Identifier, NERDTreeExecFile -> Title,
        " NERDTreeLinkFile / NERDTreeLinkDir -> Macro.
        highlight default link FernNerdTreeDirSlash Identifier
        highlight default link FernNerdTreeExecFile Title
        highlight default link FernNerdTreeSymlink  Macro
    endfunction

    " fern exposes neither the executable bit nor symlink-ness: its file provider
    " calls getftype() only to test existence and isdirectory() for the branch
    " status, and the rendered label carries no NERDTree-style `*` or `-> target`
    " to match on.  So stat each visible node and match on its name.
    "
    " Keyed on the name text rather than matchaddpos() on a line number: a
    " text-keyed syntax match survives expand/collapse shifting the lines, and it
    " is what synID() reports, whereas a match added by matchaddpos() is invisible
    " to it.  The cost is that two files sharing a basename in different dirs
    " cannot be told apart.
    function! s:fern_nerdtree_syntax() abort
        syntax match FernNerdTreeDirSlash #/# contained containedin=FernBranchText
    endfunction

    " Rebuilt on every redraw rather than once from FernSyntax: that event fires
    " while the buffer is still being created, when b:fern.visible_nodes is empty,
    " so no name is known yet.  Measured before this was split out -- the loop ran
    " zero times and every entry stayed FernLeafText, symlink and exec included.
    " Global, not script-local, because win_execute() evaluates its command string
    " outside this script's context, where s: would not resolve.
    function! g:FernNerdTreeStatSyntax() abort
        if !exists('b:fern')
            return
        endif
        silent! syntax clear FernNerdTreeExecFile
        silent! syntax clear FernNerdTreeSymlink
        for l:node in b:fern.visible_nodes
            let l:path = get(l:node, '_path', '')
            if empty(l:path)
                continue
            endif
            let l:type = getftype(l:path)
            if l:type ==# 'link'
                let l:group = 'FernNerdTreeSymlink'
            elseif l:type ==# 'file' && getfperm(l:path) =~# 'x'
                let l:group = 'FernNerdTreeExecFile'
            else
                continue
            endif
            execute printf(
                        \ 'syntax match %s /\V%s/ contained containedin=%s',
                        \ l:group,
                        \ escape(l:node.label, '/\'),
                        \ 'FernLeafText,FernBranchText')
        endfor
    endfunction

    " Driven by fern's own viewer:redraw hook, so the colours are right the moment
    " the tree is drawn -- no polling, and no waiting for the drawer to be focused.
    "
    " Two earlier attempts were wrong here and both failed silently.  Doing it
    " from User FernSyntax alone does nothing: that event fires while the buffer
    " is still being created, when b:fern.visible_nodes is empty.  And the reason
    " the hook looked dead is NOT that it goes uncalled -- it is called, but with
    " the FILE window current, so a handler guarding on b:fern bailed every time.
    " fern#hook#emit wraps callbacks in try/catch and routes the exception to
    " fern#logger#error, which is silent unless g:fern#logfile is set, so nothing
    " surfaced either way.  The helper it passes carries bufnr and winid; use them
    " rather than assuming which buffer is current.
    function! s:fern_nerdtree_redraw(helper, ...) abort
        call win_execute(a:helper.winid, 'call g:FernNerdTreeStatSyntax()')
    endfunction

    let s:fern_hooked = 0
    function! s:fern_nerdtree_hook() abort
        if s:fern_hooked
            return
        endif
        let s:fern_hooked = 1
        " fern#hook#add is only reachable once fern is on rtp, which happens at
        " plug#end() below, hence registering from the first FernSyntax.
        call fern#hook#add('viewer:redraw',
                    \ function('s:fern_nerdtree_redraw'))
    endfunction

    augroup fern_nerdtree_colours
        autocmd!
        autocmd User FernHighlight call s:fern_nerdtree_highlight()
        autocmd User FernSyntax    call s:fern_nerdtree_syntax()
        autocmd User FernSyntax    call s:fern_nerdtree_hook()
    augroup END

    """"""""""""""""""""""""""""""""""""""""
    " Nerd Commenter
