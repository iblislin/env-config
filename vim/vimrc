    """"""""""""""""""""""""""""""""""""""""
    " Fern
    """"""""""""""""""""""""""""""""""""""""
    " How to use?
    "
    " <CR>    Open selected file, or enter selected dir
    " e       Open selected file in the previous window
    " l       Open selected file, or expand selected dir
    " h       Collapse the current node
    " t       Open selected node in a new tab
    " s       Open selected file in a split window
    " E       Open selected file in a side split window
    " i       Reveal the file of the current buffer in the tree
    " !       Toggle hidden files
    " -       Mark / unmark the selected node
    " N / K   Create a new file / dir
    " c / m   Copy / move the selected node
    " D       Trash the selected node
    " <F5>    Reload the whole tree
    " <leader>n again closes the drawer
    let g:fern#drawer_width = 22
    " g:fern#default_exclude is a single pattern matched against the node label
    let s:fern_exclude = ['\~$']  " vim temp files
    let s:fern_exclude += ['\.pyc$', '\.pyo$', '^__pycache__$']  " python
    let s:fern_exclude += ['\.beam$']  " erlang
    let s:fern_exclude += ['\.a$', '\.so$', '\.o$']  " some native stuff
    let s:fern_exclude += ['^cscope\.out$']
    let g:fern#default_exclude = join(s:fern_exclude, '\|')
    let g:fern#renderer#default#collapsed_symbol = "|+ "
    let g:fern#renderer#default#expanded_symbol = "|~ "
    nnoremap <leader>n :Fern . -drawer -toggle<CR>

