if &rtp =~ 'fern'
    " Replacement for `autocmd VimEnter * NERDTree | wincmd p` and the
    " NERDTreeMirror-on-every-tab autocmd.  `-stay` is the `wincmd p`
    " equivalent: the drawer opens but the cursor stays in the file window.
    "
    " `-keep` is deliberately NOT passed.  Without it fern's own drawer
    " smart-quit (see g:fern#disable_drawer_smart_quit) quits vim when the
    " drawer is the only thing left -- natively, which is exactly what the old
    " `feedkeys(":quit\<CR>")` autocmd hand-rolled and what made it throw E38.
    " The root an existing drawer is already showing, or '.' if there is none.
    "
    " Passing '.' unconditionally is what made new tabs look "not synced": the
    " root is part of the drawer's buffer name, and <CR> (fern-action-enter)
    " changes the root, so after entering a dir the live drawer is
    " fern://drawer:0/file:///home/iblis/env-config while ':Fern .' rebuilds
    " fern://drawer:0/file:///home/iblis -- a different buffer showing the old
    " tree.  Reusing the root reproduces the same buffer name, hence the same
    " buffer.  Note `l` (expand) does NOT change the root, so it hides this.
    function! s:FernRoot() abort
        for l:i in range(1, tabpagenr('$'))
            for l:w in gettabinfo(l:i)[0].windows
                let l:name = bufname(winbufnr(l:w))
                if l:name =~# '^fern://drawer'
                    return fern#fri#parse(l:name).path
                endif
            endfor
        endfor
        return '.'
    endfunction

    " Do not auto-open the drawer when the terminal is too narrow to carry both
    " it and a usable file window -- a portrait second monitor reports ~89
    " columns, which leaves 60 for code once the drawer and the gutter are paid
    " for, well short of the 80-column ruler.  The arithmetic: drawer width, the
    " vertical separator, 'numberwidth', the two signcolumn cells the LSP
    " diagnostics claim, and then colorcolumn's first stop.
    "
    " This guards only the automatic open.  <leader>n still toggles the drawer at
    " any width, which is the escape hatch when the heuristic is wrong.
    let g:fern_drawer_min_columns =
        \ get(g:, 'fern_drawer_min_columns', g:fern#drawer_width + 1 + 4 + 2 + 80)

    function! s:FernDrawer() abort
        if &columns < g:fern_drawer_min_columns
            return
        endif
        " At most one drawer per tab.  Re-running :Fern in a tab that already
        " has one re-edits the buffer, which reloads the tree and loses the
        " expanded state on every single tab switch.
        for l:w in range(1, winnr('$'))
            if bufname(winbufnr(l:w)) =~# '^fern://drawer'
                return
            endif
        endfor
        execute printf('Fern %s -drawer -stay', fnameescape(s:FernRoot()))
    endfunction

    " timer_start(0) defers the open by one event-loop tick, OUT of the autocmd
    " context.  Opening it synchronously inside TabEnter silently does nothing
    " when the tab was created from the drawer window itself -- which is exactly
    " what fern's `t` mapping does.  fern's own debug log shows the
    " `topleft vsplit fern://drawer:0/...` running and the buffer never
    " initialising; measured sync -> no drawer, deferred -> drawer, same tab.
    "
    " nested: :Fern relies on its own BufReadCmd to render, and autocmds do not
    " fire from inside an autocmd without it.
    " SafeState rather than VimEnter for the startup drawer.  Registering the LSP
    " servers also happens at VimEnter, and opening the drawer from a timer racing
    " that work left the fern:// buffer uninitialised -- empty drawer, buftype
    " unset, "[New DIRECTORY]" on the message line.  Bisected to the LSP commit,
    " and reproduced in every directory when syncInit was set, in big projects
    " only once it was removed.  SafeState fires when vim is idle and not partway
    " through anything, which is the condition :Fern actually needs; ++once keeps
    " it to the one startup open.
    autocmd SafeState * ++once nested call s:FernDrawer()
    autocmd TabEnter * nested call timer_start(0, { -> s:FernDrawer() })
endif

" Two things made the previous form a no-op, and between them they are why the
" java entry above never did anything and why the Plug line got commented out:
"
"   1. plugin/lsp.vim is sourced by vim AFTER this vimrc finishes, so
"      exists('*LspAddServer') is ALWAYS false at this point.  The guard
"      therefore registered nothing, silently.
"   2. the plugin declares `def g:LspAddServer()` / `def g:LspOptionsSet()`, so
"      the names carry the g: prefix.
"
" VimEnter runs after plugin loading, which is late enough for both.
if &rtp =~ 'plugged/lsp'
    function! s:LspSetup() abort
        if !exists('*g:LspAddServer')
            echomsg 'lsp: g:LspAddServer is missing, no servers registered'
            return
        endif
        call g:LspOptionsSet(g:lspOpts)
        call g:LspAddServer(g:lspServers)
    endfunction

    autocmd VimEnter * call s:LspSetup()

    " Buffer-local so a file with no server keeps vim's own gd (local
    " declaration) and K (keywordprg).  These replace what the dead
    " LanguageClient-neovim block used to claim globally -- it mapped gd and K
    " to functions no installed plugin defined, so both raised E117.
    "
    " nvim needs no counterpart: it maps K to vim.lsp.buf.hover() itself, but
    " only when no custom K mapping exists, so the global map above was
    " suppressing it.  gd is set in nvim/config/lua/lsp_common.lua; the rest of
    " nvim's LSP keys (grn, grr, gra, gri, gO) are global defaults.
    autocmd User LspAttached nnoremap <buffer> <silent> gd <cmd>LspGotoDefinition<cr>
    autocmd User LspAttached nnoremap <buffer> <silent> K  <cmd>LspHover<cr>
    autocmd User LspAttached nnoremap <buffer> <silent> [d <cmd>LspDiag prev<cr>
    autocmd User LspAttached nnoremap <buffer> <silent> ]d <cmd>LspDiag next<cr>

    " The <leader>l set mirrors nvim's, which had to move off the gr prefix: nvim
    " 0.11 claimed grn/grr/gra/gri/grt/grx as global defaults, colliding with
    " `gr` -> :tabp above and stalling it for 'timeoutlen' (measured 1123 ms vs
    " 20 ms for gt).  vim has no such defaults and no collision, but the keys are
    " duplicated here so muscle memory carries between the two editors.
    autocmd User LspAttached nnoremap <buffer> <silent> <leader>lr <cmd>LspRename<cr>
    autocmd User LspAttached nnoremap <buffer> <silent> <leader>lR <cmd>LspShowReferences<cr>
    autocmd User LspAttached nnoremap <buffer> <silent> <leader>la <cmd>LspCodeAction<cr>
    autocmd User LspAttached nnoremap <buffer> <silent> <leader>li <cmd>LspGotoImpl<cr>
    autocmd User LspAttached nnoremap <buffer> <silent> <leader>lt <cmd>LspGotoTypeDef<cr>
    autocmd User LspAttached nnoremap <buffer> <silent> <leader>lx <cmd>LspCodeLens<cr>
endif

" mkgoal: rough intent -> a validated /goal condition
"
" Both bindings are ASYNCHRONOUS: a run is drafting plus two Haiku judges plus
" up to three rewrites, so 30-90s, and a synchronous :%! or systemlist() freezes
" vim for all of it with no output. There is nothing the sync form did better,
" so it is gone -- :%!mkgoal still works by hand if ever wanted.
"
"   ,g  replaces (whole buffer in normal mode, the selection in visual)
"   ,G  appends (at end of file, or after the selection)
"
" Safety: b:changedtick is recorded at launch and checked on completion. If the
" buffer was edited while the job ran, a replace DEGRADES TO AN APPEND and says
" so -- overwriting a buffer you have since typed into is not recoverable in one
" undo. Input is taken from the buffer in memory, never from the file on disk,
" so an unsaved scratch buffer (the likely place to draft an intent) works.

let s:mkgoal_out = []
let s:mkgoal_err = []
let s:mkgoal_buf = 0
let s:mkgoal_tick = -1
let s:mkgoal_lo = 0
let s:mkgoal_hi = 0
let s:mkgoal_replace = 0
let s:mkgoal_t0 = 0
let s:mkgoal_job = v:null
let s:mkgoal_timer = -1
let s:mkgoal_spin = ['|', '/', '-', '\']
let s:mkgoal_tick_n = 0

" Ticking progress line. Elapsed seconds and a spinner are real; the STAGE is
" deliberately absent. mkgoal is one `claude -p` call and cannot see whether the
" agent is drafting, judging or rewriting, so any stage label here would be a
" guess presented as fact. Only stream-json parsing would make stages honest.
function! s:MkgoalTick(_) abort
    if s:mkgoal_job is v:null
        return
    endif
    " Never clobber the command line while it is being used for input.
    if mode() =~# '^[c]'
        return
    endif
    let s:mkgoal_tick_n += 1
    let l:c = s:mkgoal_spin[s:mkgoal_tick_n % len(s:mkgoal_spin)]
    echo printf('%s mkgoal running %ds (buffer %d, %s)',
                \ l:c, localtime() - s:mkgoal_t0, s:mkgoal_buf,
                \ s:mkgoal_replace ? 'will replace' : 'will append')
endfunction

function! s:MkgoalStopTimer() abort
    if s:mkgoal_timer >= 0
        call timer_stop(s:mkgoal_timer)
        let s:mkgoal_timer = -1
    endif
    echo ''
endfunction

function! s:MkgoalFinish(status) abort
    let l:secs = localtime() - s:mkgoal_t0
    let s:mkgoal_job = v:null
    call s:MkgoalStopTimer()
    " The target buffer may be gone: an async run outlives :bd, and appending to
    " a dead buffer throws rather than warning.
    if !bufexists(s:mkgoal_buf)
        echohl WarningMsg
        echomsg printf('mkgoal: buffer %d no longer exists, result discarded (%ds)',
                    \  s:mkgoal_buf, l:secs)
        echohl None
        return
    endif
    if empty(s:mkgoal_out)
        echohl ErrorMsg
        echomsg printf('mkgoal: no condition produced, exit %d after %ds -- %s',
                    \  a:status, l:secs, join(s:mkgoal_err[-2:], ' | '))
        echohl None
        return
    endif

    " Surface only the machine-readable verdict lines; the prose reasoning stays
    " in :messages via the err accumulator.
    let l:v = filter(copy(s:mkgoal_err), 'v:val =~# "^\\(STATUS\\|rewrites\\|judge_model\\)="')
    let l:edited = getbufvar(s:mkgoal_buf, 'changedtick') != s:mkgoal_tick
    let l:how = 'appended'

    if s:mkgoal_replace && l:edited
        " Refuse to overwrite work done while the job ran. Appending loses
        " nothing; replacing would lose it and one undo would not bring it back.
        call appendbufline(s:mkgoal_buf, '$', [''] + s:mkgoal_out)
        echohl WarningMsg
        echomsg printf('mkgoal: buffer was edited during the run, so APPENDED instead of replacing (%ds). %s',
                    \  l:secs, join(l:v, '  '))
        echohl None
        return
    elseif s:mkgoal_replace
        call deletebufline(s:mkgoal_buf, s:mkgoal_lo, s:mkgoal_hi)
        if s:mkgoal_lo <= 1
            call setbufline(s:mkgoal_buf, 1, s:mkgoal_out)
        else
            call appendbufline(s:mkgoal_buf, s:mkgoal_lo - 1, s:mkgoal_out)
        endif
        let l:how = 'replaced'
    else
        " Append after the recorded range, or at the end if it no longer exists.
        let l:at = l:edited ? '$' : s:mkgoal_hi
        call appendbufline(s:mkgoal_buf, l:at, [''] + s:mkgoal_out)
    endif

    echomsg printf('mkgoal: %d lines %s after %ds. %s',
                \  len(s:mkgoal_out), l:how, l:secs, join(l:v, '  '))
endfunction

function! s:MkgoalAsync(lo, hi, replace) abort
    if s:mkgoal_job isnot v:null
        echohl WarningMsg
        echomsg 'mkgoal: a run is already in flight; wait for it or restart vim'
        echohl None
        return
    endif
    let l:lines = getline(a:lo, a:hi)
    if empty(filter(copy(l:lines), '!empty(trim(v:val))'))
        echohl ErrorMsg | echomsg 'mkgoal: nothing to send' | echohl None
        return
    endif
    let s:mkgoal_out = []
    let s:mkgoal_err = []
    let s:mkgoal_buf = bufnr('%')
    let s:mkgoal_tick = b:changedtick
    let s:mkgoal_lo = a:lo
    let s:mkgoal_hi = a:hi
    let s:mkgoal_replace = a:replace
    let s:mkgoal_t0 = localtime()

    if has('nvim')
        let s:mkgoal_job = jobstart(['mkgoal'], {
                    \ 'stdout_buffered': v:true, 'stderr_buffered': v:true,
                    \ 'on_stdout': {j,d,e -> extend(s:mkgoal_out, filter(d, '!empty(v:val)'))},
                    \ 'on_stderr': {j,d,e -> extend(s:mkgoal_err, filter(d, '!empty(v:val)'))},
                    \ 'on_exit':   {j,c,e -> s:MkgoalFinish(c)},
                    \ })
        call chansend(s:mkgoal_job, l:lines)
        call chanclose(s:mkgoal_job, 'stdin')
    else
        let s:mkgoal_job = job_start(['mkgoal'], {
                    \ 'in_io': 'pipe',
                    \ 'out_cb': {ch,msg -> add(s:mkgoal_out, msg)},
                    \ 'err_cb': {ch,msg -> add(s:mkgoal_err, msg)},
                    \ 'exit_cb': {job,st -> s:MkgoalFinish(st)},
                    \ })
        let l:ch = job_getchannel(s:mkgoal_job)
        for l:line in l:lines
            call ch_sendraw(l:ch, l:line . "\n")
        endfor
        call ch_close_in(l:ch)
    endif
    " 150ms is fast enough to read as motion without burning noticeable CPU on a
    " job that runs for a minute or two.
    let s:mkgoal_tick_n = 0
    let s:mkgoal_timer = timer_start(150, function('s:MkgoalTick'), {'repeat': -1})
    echomsg printf('mkgoal: started on %d lines, measured 100s for a real intent -- keep working',
                \  len(l:lines))
endfunction

"                                        lo            hi          replace?
nnoremap <leader>g :call <SID>MkgoalAsync(1, line('$'), 1)<CR>
xnoremap <leader>g :<C-u>call <SID>MkgoalAsync(line("'<"), line("'>"), 1)<CR>
nnoremap <leader>G :call <SID>MkgoalAsync(1, line('$'), 0)<CR>
xnoremap <leader>G :<C-u>call <SID>MkgoalAsync(line("'<"), line("'>"), 0)<CR>

" ,h -- pull the previous phase's handoff block into this buffer.
"
" mkgoal starts a fresh `claude -p`: it loads the global CLAUDE.md, the cwd's
" project CLAUDE.md and skills, and reads whatever it wants with tools -- but
" never the memory files and never the previous session's conversation. So a
" second phase of related work gets drafted blind to what the first established.
" The writing-goal-conditions skill closes that by making the last done-clause
" of each phase append its successor's intent to the file below; this reads it
" back. /copy is the other route to the same text when the block is fenced.
function! s:MkgoalCachePath(name) abort
    " Derived from vim's cwd, NOT from the current buffer's path -- deliberate.
    " Ctrl-G opens a scratch file under /tmp while leaving cwd at the session's
    " directory, so the buffer sits outside the repo and only cwd identifies it.
    " `autochdir` is off in this file, which is what keeps that true.
    let l:root = trim(system('git rev-parse --show-toplevel 2>/dev/null'))
    if v:shell_error != 0 || empty(l:root)
        return ''
    endif
    " Keyed on the repo, not the session: a session id is the one thing another
    " process cannot derive. /home/iblis/env-config -> -home-iblis-env-config,
    " matching Claude Code's own projects/-home-iblis naming. This is also what
    " lets a DIFFERENT Claude session write the file: it knows the target repo,
    " so it can compute the same path without knowing anything about this vim.
    return expand('~/.cache/mkgoal/') . substitute(l:root, '/', '-', 'g')
                \ . '/' . a:name
endfunction

function! s:MkgoalHandoffPath() abort
    return s:MkgoalCachePath('next-intent.md')
endfunction

function! s:MkgoalHandoff() abort
    let l:path = s:MkgoalHandoffPath()
    if empty(l:path)
        echohl ErrorMsg
        echomsg 'mkgoal: not inside a git repo, so no handoff path to derive'
        echohl None
        return
    endif
    if !filereadable(l:path)
        echohl WarningMsg
        echomsg printf('mkgoal: no handoff written yet -- %s',
                    \  fnamemodify(l:path, ':~'))
        echohl None
        return
    endif

    " The file is APPENDED to, one dated `## ` block per phase, so take only the
    " LAST block. Reading the whole file would drag every earlier phase into the
    " intent; the full file is the chain's audit trail, meant to be read with
    " :view rather than sent to mkgoal.
    let l:lines = readfile(l:path)
    let l:start = -1
    for l:i in range(len(l:lines))
        if l:lines[l:i] =~# '^## '
            let l:start = l:i
        endif
    endfor
    let l:block = l:start < 0 ? l:lines : l:lines[l:start :]
    while !empty(l:block) && empty(trim(l:block[-1]))
        call remove(l:block, -1)
    endwhile
    if empty(l:block)
        echohl WarningMsg
        echomsg 'mkgoal: handoff file has no content'
        echohl None
        return
    endif

    " Ctrl-G hands us an empty buffer, and append() would leave a blank first
    " line in exactly that common case.
    if line('$') == 1 && empty(getline(1))
        call setline(1, l:block)
    else
        call append(line('.'), l:block)
    endif
    echomsg printf('mkgoal: read %d lines -- %s', len(l:block),
                \  strcharpart(trim(l:block[0]), 0, 60))
endfunction

nnoremap <leader>h :call <SID>MkgoalHandoff()<CR>

" ,c -- pull a ready-made /goal condition written by ANOTHER Claude session.
"
" A yank register lives inside one Claude Code process and has no external write
" path, so session 1 cannot load session 2's register directly. A file keyed on
" the target repo is the bridge: the screening session already knows which repo
" the work is in, so it can compute this exact path, and the session that opens
" there can read it back without being told anything.
"
" Whole file, not the last block -- unlike next-intent.md this is overwritten
" rather than appended, because a condition is the current one, not a log.
function! s:MkgoalCondition() abort
    let l:path = s:MkgoalCachePath('goal.md')
    if empty(l:path)
        echohl ErrorMsg
        echomsg 'mkgoal: not inside a git repo, so no condition path to derive'
        echohl None
        return
    endif
    if !filereadable(l:path)
        echohl WarningMsg
        echomsg printf('mkgoal: no condition staged for this repo -- %s',
                    \  fnamemodify(l:path, ':~'))
        echohl None
        return
    endif
    let l:lines = readfile(l:path)
    while !empty(l:lines) && empty(trim(l:lines[-1]))
        call remove(l:lines, -1)
    endwhile
    if empty(l:lines)
        echohl WarningMsg | echomsg 'mkgoal: staged condition is empty' | echohl None
        return
    endif
    " Ctrl-G hands over an empty buffer, where append() would leave a blank
    " first line -- and a leading blank line before `/goal ` would stop Claude
    " Code parsing it as a slash command at all.
    if line('$') == 1 && empty(getline(1))
        call setline(1, l:lines)
    else
        call append(line('.'), l:lines)
    endif
    echomsg printf('mkgoal: staged condition, %d lines -- %s', len(l:lines),
                \  strcharpart(trim(l:lines[0]), 0, 58))
endfunction

nnoremap <leader>c :call <SID>MkgoalCondition()<CR>
