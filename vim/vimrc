function! SmartNewLine()
if has("python3")
python3 << EOF
def f():
    import vim

    line = vim.current.line
    buffer = vim.current.buffer
    cursor_row, cursor_col = vim.current.window.cursor

    if not line[:cursor_col].lstrip():
        vim.command("return 0")
    else:
        vim.command("return 1")

f()
del f
EOF
elseif has("python")
python << EOF
def f():
    import vim

    line = vim.current.line
    buffer = vim.current.buffer
    cursor_row, cursor_col = vim.current.window.cursor

    if not line[:cursor_col].lstrip():
        vim.command("return 0")
    else:
        vim.command("return 1")

f()
del f
EOF
endif
endfunction

