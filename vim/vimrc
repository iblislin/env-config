    """"""""""""""""""""""""""""""""""""""""
    "  lsp
    """"""""""""""""""""""""""""""""""""""""
    " The interpreter is per-project and is chosen by zsh's venv dispatcher from
    " the tmux session prefix -- zshrc does
    "   source $HOME/venv/`tmux_sess_prefix`/bin/activate
    " falling back to ~/venv/py3 -- so $VIRTUAL_ENV is the authority and naming
    " one venv here would aim the server at the wrong interpreter for every
    " project but one.  ~/venv/command-center is 3.12 with the project's deps;
    " ~/venv/py3 does not have them.
    "
    " The server BINARIES stay in ~/venv/py3 deliberately: basedpyright and ruff
    " are tools, not project dependencies, and are not installed in the
    " per-project venvs.
    function! s:PyInterp() abort
        let l:venv = empty($VIRTUAL_ENV) ? expand('~/venv/py3') : $VIRTUAL_ENV
        return l:venv . '/bin/python3'
    endfunction

    " Do NOT set syncInit here.  It is for servers slow to answer "initialize"
    " (rust-analyzer, gopls) and makes vim block synchronously while waiting.
    " Registering servers at VimEnter while the fern drawer also opens at VimEnter
    " is a race, and syncInit turned that race into a guaranteed loss: timers fire
    " during the block, so :Fern created its fern:// buffer inside the blocked
    " init, fern's BufReadCmd never ran, and the drawer stayed an uninitialised
    " buffer with buftype unset -- which vim reports as "[New DIRECTORY]".
    " Removing syncInit alone was not enough on a big project; see the SafeState
    " autocmd in the Autocmd section for the actual fix.
    "
    " basedpyright is listed FIRST on purpose.  With several servers attached to
    " one buffer this client hands completion / hover / signature to the first
    " server that supports them and only *merges* diagnostics across all of them
    " (see |lsp-multiple-servers|), so basedpyright owns the intelligence and
    " ruff adds lint diagnostics on top.
    "
    " workspaceConfig is sent as "settings" in workspace/didChangeConfiguration
    " and also answers workspace/configuration -- that is where the interpreter
    " has to be named.  It matters here more than usual: this box's python3 is
    " ~/venv/py3 (3.12) while /usr/bin/python3 is 3.14, so a server left to guess
    " picks the system one and reports every third-party import as unresolved,
    " which looks exactly like the jedi-era breakage and is not one.
    let lspServers = [
    \     #{
    \        name: 'jdtls',
    \        filetype: ['java'],
    \        path: '/usr/bin/jdtls',
    \        args: []
    \      },
    \     #{
    \        name: 'basedpyright',
    \        filetype: ['python'],
    \        path: expand('~/venv/py3/bin/basedpyright-langserver'),
    \        args: ['--stdio'],
    \        rootSearch: ['pyproject.toml', 'poetry.lock', 'setup.py', '.git/'],
    \        workspaceConfig: #{
    \           python: #{
    \              pythonPath: s:PyInterp()
    \           },
    \           basedpyright: #{
    \              analysis: #{
    \                 diagnosticMode: 'openFilesOnly',
    \                 typeCheckingMode: 'standard'
    \              }
    \           }
    \        }
    \      },
    \     #{
    \        name: 'ruff',
    \        filetype: ['python'],
    \        path: expand('~/venv/py3/bin/ruff'),
    \        args: ['server'],
    \        rootSearch: ['pyproject.toml', 'ruff.toml', '.git/']
    \      }
    \   ]

    " omniComplete is what points &omnifunc at g:LspOmniFunc, so <C-x><C-o> is a
    " manual trigger for the same source that autoComplete pops up on its own.
    " Without it &omnifunc stays empty and CTRL-X CTRL-O does nothing.
    let lspOpts = #{
